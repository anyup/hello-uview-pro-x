{
    "name": "hello-uview-pro-x",
    "version": "1.0.7",
    "description": "uView Pro X 演示工程（uni-app x）",
    "scripts": {
        "sync": "node scripts/sync-split.mjs",
        "sync:demo": "node scripts/sync-split.mjs --part demo",
        "sync:lib": "node scripts/sync-split.mjs --part lib",
        "sync:dry": "node scripts/sync-split.mjs --dry-run",
        "changelog:release": "node scripts/generate-changelog.js --emoji --current --no-unreleased --no-hash --exclude-types=build,chore,ci,docs,revert,test --merge-repo=uni_modules/uview-pro-x",
        "changelog:lib": "node scripts/generate-changelog.js --emoji --current --no-unreleased --no-hash --exclude-types=build,chore,ci,docs,revert,test --repo=uni_modules/uview-pro-x --output=uni_modules/uview-pro-x/changelog.md --merge-repo=.",
        "changelog:docs": "node scripts/generate-changelog.js --emoji --current --no-unreleased --no-hash --exclude-types=build,chore,ci,docs,revert,test --repo=uni_modules/uview-pro-x --output=uview-pro-x-doc/docs/zh/components/changelog.md --merge-repo=.",
        "changelog:all": "node scripts/generate-changelog.js --emoji --all --no-unreleased --no-hash",
        "release:patch": "node scripts/release.js patch",
        "release:minor": "node scripts/release.js minor",
        "release:major": "node scripts/release.js major",
        "release:beta": "node scripts/release.js prerelease beta",
        "release:alpha": "node scripts/release.js prerelease alpha",
        "release:rc": "node scripts/release.js prerelease rc",
        "release:push": "node scripts/release.js push",
        "release:undo": "node scripts/release.js undo"
    }
}
