<script setup lang="uts">
	import { $u } from '@/uni_modules/uview-pro-x'
	import { customIconFont } from './iconfont.uts'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('App Launch')
		// 自定义字体图标：登记「前缀 → 码点表」，与下方 @font-face 的 font-family 同名（ux-icon 按 custom-prefix 检索）
		$u.registerIconFont('custom-icon', customIconFont)
	})

	onAppShow(() => {
		console.log('App Show')
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style lang="scss">
	/* 每个页面公共css */
	/* 引入演示页面公共样式 */
	@import '@/style/demo.scss';
	@import '@/style/reset.scss';

	/* 演示用自定义图标字体：字体文件必须放在 static 目录，否则打包时不会被带进去 */
	/* 该字体族名需与 $u.registerIconFont 的前缀、以及码点表的类名前缀三者一致 */
	/* uni-app x 的 @font-face 只支持 font-family 与 src，写 font-weight/font-style/font-display 会编译报错 */
	@font-face {
		font-family: 'custom-icon';
		src: url('/static/iconfont.ttf');
	}

	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
</style>