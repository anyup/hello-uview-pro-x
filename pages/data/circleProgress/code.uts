/** 动态进度 */
const dynamic = `
<template>
    <view class="wrap">
        <ux-circle-progress :percent="percent" type="success">
            <text class="percent">{{ percent + '%' }}</text>
        </ux-circle-progress>
    </view>
    <view class="btn-row">
        <view class="btn" @click="reduce">
            <text class="btn-text">-</text>
        </view>
        <text class="btn-value">{{ percent + '%' }}</text>
        <view class="btn" @click="add">
            <text class="btn-text">+</text>
        </view>
    </view>
</template>

<script setup lang="uts">
const percent = ref<number>(65);

function add(): void {
    percent.value = Math.min(percent.value + 10, 100);
}

function reduce(): void {
    percent.value = Math.max(percent.value - 10, 0);
}
</script>

<style scoped>
.wrap {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 20px 0;
}
.percent {
    font-size: 20px;
    font-weight: bold;
    color: #303133;
}
.btn-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}
.btn {
    width: 40px;
    height: 40px;
    border-radius: 40px;
    background-color: #2979ff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.btn-text {
    font-size: 22px;
    color: #ffffff;
    line-height: 22px;
}
.btn-value {
    font-size: 18px;
    font-weight: bold;
    color: #303133;
    margin: 0 20px;
    min-width: 60px;
    text-align: center;
}
</style>
`;

/** 自定义样式 */
const custom = `
<template>
    <view class="wrap">
        <ux-circle-progress
            :percent="percent"
            :active-color="activeColor"
            :inactive-color="inactiveColor"
            :bg-color="bgColor"
            :duration="duration"
        >
            <text class="percent">{{ percent + '%' }}</text>
        </ux-circle-progress>
    </view>
    <view class="btn-row">
        <view class="btn" @click="reduce">
            <text class="btn-text">-</text>
        </view>
        <text class="btn-value">{{ percent + '%' }}</text>
        <view class="btn" @click="add">
            <text class="btn-text">+</text>
        </view>
    </view>
</template>

<script setup lang="uts">
const percent = ref<number>(80);
const activeColor = '#19be6b';
const inactiveColor = '#ebeef5';
const bgColor = '#f4f6f8';
const duration = 2000;

function add(): void {
    percent.value = Math.min(percent.value + 10, 100);
}

function reduce(): void {
    percent.value = Math.max(percent.value - 10, 0);
}
</script>

<style scoped>
.wrap {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 20px 0;
}
.percent {
    font-size: 20px;
    font-weight: bold;
    color: #303133;
}
.btn-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}
.btn {
    width: 40px;
    height: 40px;
    border-radius: 40px;
    background-color: #19be6b;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.btn-text {
    font-size: 22px;
    color: #ffffff;
    line-height: 22px;
}
.btn-value {
    font-size: 18px;
    font-weight: bold;
    color: #303133;
    margin: 0 20px;
    min-width: 60px;
    text-align: center;
}
</style>
`;

