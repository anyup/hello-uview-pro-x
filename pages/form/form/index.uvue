﻿<template>
    <demo-page :title="t('form.title')" :subtitle="t('form.subtitle')">

        <!-- 综合大表单 -->
        <demo-block :title="t('form.basicTitle')" :desc="t('form.basicDesc')" :code="codes.basic">
            <view class="form-wrap">
                <ux-form
                    ref="formRef"
                    :model="model"
                    :rules="rules"
                    :error-type="errorType"
                    :label-position="labelPosition"
                    :label-width="labelWidth"
                    :size="formSize"
                >
                    <!-- 姓名：左图标 + 必填 + 长度 + 中文校验 -->
                    <ux-form-item
                        :label="t('form.nameLabel')"
                        prop="name"
                        required
                        left-icon="account"
                        :left-icon-style="iconStyle"
                    >
                        <ux-input v-model="model.name" :placeholder="t('form.namePlaceholder')" border />
                    </ux-form-item>
                    <!-- 简介：多行文本 + 字数统计 -->
                    <ux-form-item :label="t('form.introLabel')" prop="intro">
                        <ux-textarea v-model="model.intro" :placeholder="t('form.introPlaceholder')" border count />
                    </ux-form-item>
                    <!-- 特长：嵌套路径校验 extra.strong -->
                    <ux-form-item :label="t('form.extraLabel')" prop="extra.strong">
                        <ux-textarea v-model="extraStrong" :placeholder="t('form.extraPlaceholder')" border />
                    </ux-form-item>
                    <!-- 密码：密码框 + 显隐图标 + 正则 -->
                    <ux-form-item :label="t('form.passwordLabel')" prop="password">
                        <ux-input
                            v-model="model.password"
                            type="password"
                            :password-icon="true"
                            :placeholder="t('form.passwordPlaceholder')"
                            border
                        />
                    </ux-form-item>
                    <!-- 确认密码：一致性校验 -->
                    <ux-form-item :label="t('form.rePasswordLabel')" prop="rePassword">
                        <ux-input
                            v-model="model.rePassword"
                            type="password"
                            :placeholder="t('form.rePasswordPlaceholder')"
                            border
                        />
                    </ux-form-item>
                    <!-- 性别：select 输入框 + picker 联动 -->
                    <ux-form-item :label="t('form.sexLabel')" prop="sex">
                        <ux-input
                            v-model="model.sex"
                            type="select"
                            :select-open="sexPickerShow"
                            :placeholder="t('form.sexPlaceholder')"
                            border
                            @click="openSexPicker"
                        />
                    </ux-form-item>
                    <!-- 手机号：数字输入 + 格式校验 -->
                    <ux-form-item :label="t('form.phoneLabel')" prop="phone">
                        <ux-input v-model="model.phone" type="number" :placeholder="t('form.phonePlaceholder')" border />
                    </ux-form-item>
                    <!-- 邮箱：格式校验（非必填） -->
                    <ux-form-item :label="t('form.emailLabel')" prop="email">
                        <ux-input v-model="model.email" :placeholder="t('form.emailPlaceholder')" border />
                    </ux-form-item>
                    <!-- 喜欢的水果：多选 -->
                    <ux-form-item :label="t('form.checkboxLabel')" prop="fruit">
                        <ux-checkbox-group v-model="model.fruit">
                            <ux-checkbox :label="t('form.fruitApple')" name="apple" />
                            <ux-checkbox :label="t('form.fruitBanana')" name="banana" />
                            <ux-checkbox :label="t('form.fruitOrange')" name="orange" />
                        </ux-checkbox-group>
                    </ux-form-item>
                    <!-- 支付方式：单选 -->
                    <ux-form-item :label="t('form.payLabel')" prop="payType">
                        <ux-radio-group v-model="model.payType">
                            <ux-radio :label="t('form.payAlipay')" name="alipay" />
                            <ux-radio :label="t('form.payWechat')" name="wechat" />
                            <ux-radio :label="t('form.payUnion')" name="union" />
                            <ux-radio :label="t('form.payCash')" name="cash" />
                        </ux-radio-group>
                    </ux-form-item>
                    <!-- 所在地区：级联选择 -->
                    <ux-form-item :label="t('form.regionLabel')" prop="region">
                        <ux-input
                            v-model="model.region"
                            type="select"
                            :select-open="regionPickerShow"
                            :placeholder="t('form.regionPlaceholder')"
                            border
                            @click="openRegionPicker"
                        />
                    </ux-form-item>
                    <!-- 商品类型：下拉选择 -->
                    <ux-form-item :label="t('form.goodsLabel')" prop="goodsType">
                        <ux-input
                            v-model="model.goodsType"
                            type="select"
                            :select-open="goodsSelectShow"
                            :placeholder="t('form.goodsPlaceholder')"
                            border
                            @click="openGoodsSelect"
                        />
                    </ux-form-item>
                    <!-- 评分 -->
                    <ux-form-item :label="t('form.rateLabel')" prop="rate">
                        <ux-rate v-model="model.rate" />
                    </ux-form-item>
                    <!-- 满意度：滑块 -->
                    <ux-form-item :label="t('form.sliderLabel')" prop="slider">
                        <ux-slider v-model="model.slider" :start="0" :end="100" />
                    </ux-form-item>
                    <!-- 数量：步进器 -->
                    <ux-form-item :label="t('form.numberBoxLabel')" prop="number">
                        <ux-number-box v-model="model.number" :min="1" :max="99" />
                    </ux-form-item>
                    <!-- 记住密码：开关置于右侧插槽 -->
                    <ux-form-item :label="t('form.rememberLabel')" prop="remember">
                        <template #right>
                            <ux-switch v-model="model.remember" />
                        </template>
                    </ux-form-item>
                </ux-form>

                <!-- 协议勾选 -->
                <view class="agreement">
                    <ux-checkbox v-model="agreement" :label="t('form.agreement')" />
                </view>

                <!-- 提交 / 重置 -->
                <view class="btn-wrap">
                    <ux-button type="primary" custom-class="btn-item" size="small" shape="round" @click="onSubmit">{{ t('form.submitBtn') }}</ux-button>
                    <ux-button type="default" custom-class="btn-item" size="small" shape="round" @click="onReset">{{ t('form.resetBtn') }}</ux-button>
                </view>
            </view>
        </demo-block>

        <!-- 参数配置 -->
        <demo-block :title="t('form.configTitle')" :code="codes.config">

            <text class="config-label">{{ t('form.errorTypeTitle') }}</text>
            <view class="btn-wrap">
                <ux-button
                    v-for="(item, index) in errorTypeList"
                    :key="index"
                    size="small"
                    shape="round"
                    custom-class="btn-item"
                    :type="errorTypeKey === item.value ? 'primary' : 'default'"
                    @click="setErrorType(item.value)"
                >{{ item.label }}</ux-button>
            </view>

            <text class="config-label">{{ t('form.labelPositionTitle') }}</text>
            <view class="btn-wrap">
                <ux-button
                    v-for="(item, index) in labelPosList"
                    :key="index"
                    size="small"
                    shape="round"
                    custom-class="btn-item"
                    :type="labelPosition === item.value ? 'primary' : 'default'"
                    @click="setLabelPosition(item.value)"
                >{{ item.label }}</ux-button>
            </view>

            <text class="config-label">{{ t('form.sizeTitle') }}</text>
            <view class="btn-wrap">
                <ux-button
                    v-for="(item, index) in sizeList"
                    :key="index"
                    size="small"
                    shape="round"
                    custom-class="btn-item"
                    :type="formSize === item.value ? 'primary' : 'default'"
                    @click="setSize(item.value)"
                >{{ item.label }}</ux-button>
            </view>
        </demo-block>

        <!-- 弹层：性别 / 地区 / 商品类型 -->
        <ux-picker v-model="sexPickerShow" mode="selector" :columns="sexColumns" @confirm="onSexConfirm" />
        <ux-picker v-model="regionPickerShow" mode="cascade" :columns="regionColumns" @confirm="onRegionConfirm" />
        <ux-select v-model="goodsSelectShow" mode="single-column" :list="goodsList" @confirm="onGoodsConfirm" />

    </demo-page>
</template>

<script setup lang="uts">
    import { useLocale, type FormRule, type FormErrorType, type SelectListItem, type PickerOption } from '@/uni_modules/uview-pro-x';
    import { codes } from './code';

    const { t } = useLocale('demo');

    /** 左侧图标样式 */
    const iconStyle: UTSJSONObject = { 'color': '#888888', 'fontSize': '16px' };

    // ==================== 表单数据 ====================

    const formRef = ref<any | null>(null);
    const model = ref<UTSJSONObject>(new UTSJSONObject());
    model.value['name'] = '';
    model.value['intro'] = '';
    model.value['extra'] = { 'strong': '' };
    model.value['password'] = '';
    model.value['rePassword'] = '';
    model.value['sex'] = '';
    model.value['phone'] = '';
    model.value['email'] = '';
    model.value['fruit'] = [];
    model.value['payType'] = '';
    model.value['region'] = '';
    model.value['goodsType'] = '';
    model.value['rate'] = 0;
    model.value['slider'] = 50;
    model.value['number'] = 1;
    model.value['remember'] = false;

    /**
     * 嵌套字段 extra.strong：UTSJSONObject 深层访问在模板中会被判为可空，
     * 用计算属性隔离并在脚本内显式断言，避免 "Object is possibly 'null'" 告警。
     * 校验规则 prop 仍用 "extra.strong"，由 ux-form 内部经下标读取。
     */
    const extraStrong = computed<string>({
        get: (): string => {
            const extra = model.value['extra'] as UTSJSONObject;
            if (extra == null) return '';
            return (extra['strong'] as string) ?? '';
        },
        set: (val: string): void => {
            const extra = model.value['extra'] as UTSJSONObject;
            if (extra != null) {
                extra['strong'] = val;
            }
        }
    });

    /** 协议勾选（表单外，提交前校验） */
    const agreement = ref<boolean>(false);

    // ==================== form 配置（参数配置区驱动） ====================

    const errorType = ref<FormErrorType[]>(['message']);
    const labelPosition = ref<'left' | 'top'>('left');
    const labelWidth = ref<string | number>(70);
    const formSize = ref<string>('default');

    // ==================== 校验规则 ====================

    const rules = ref<Map<string, FormRule[]>>(new Map([
        ['name', [
            { required: true, message: '请输入姓名', trigger: 'blur' },
            { min: 3, max: 5, message: '姓名长度在 3 到 5 个字符', trigger: 'change' },
            {
                validator: (value: any | null): boolean | string => {
                    if (value == null || value === '') return true;
                    if (!/^[\u4e00-\u9fa5]+$/.test(String(value))) return '姓名必须为中文';
                    return true;
                },
                trigger: 'change'
            }
        ]],
        ['intro', [
            { required: true, message: '请输入简介', trigger: 'blur' },
            { min: 5, message: '简介不能少于 5 个字', trigger: 'change' }
        ]],
        ['extra.strong', [
            { required: true, message: '请输入特长', trigger: 'blur' },
            { min: 5, message: '特长不能少于 5 个字', trigger: 'change' }
        ]],
        ['password', [
            { required: true, message: '请输入密码', trigger: 'blur' },
            {
                pattern: /^(?![0-9]+$)(?![a-zA-Z]+$)[0-9A-Za-z]+\S{5,12}$/,
                message: '需同时含有字母和数字，长度在 6-12 之间',
                trigger: 'change'
            }
        ]],
        ['rePassword', [
            { required: true, message: '请再次输入密码', trigger: 'blur' },
            {
                validator: (value: any | null): boolean | string => {
                    if (value !== model.value['password']) return '两次输入的密码不一致';
                    return true;
                },
                trigger: 'change'
            }
        ]],
        ['sex', [{ required: true, message: '请选择性别', trigger: 'change' }]],
        ['phone', [
            { required: true, message: '请输入手机号', trigger: 'blur' },
            {
                validator: (value: any | null): boolean | string => {
                    if (value == null || value === '') return true;
                    if (!/^1[3-9]\d{9}$/.test(String(value))) return '手机号码不正确';
                    return true;
                },
                trigger: 'change'
            }
        ]],
        ['email', [
            {
                validator: (value: any | null): boolean | string => {
                    if (value == null || value === '') return true;
                    if (!/^[\w.-]+@[\w.-]+\.\w+$/.test(String(value))) return '邮箱格式不正确';
                    return true;
                },
                trigger: 'change'
            }
        ]],
        ['fruit', [{ required: true, message: '请选择喜欢的水果', trigger: 'change' }]],
        ['payType', [{ required: true, message: '请选择支付方式', trigger: 'change' }]],
        ['region', [{ required: true, message: '请选择所在地区', trigger: 'change' }]],
        ['goodsType', [{ required: true, message: '请选择商品类型', trigger: 'change' }]]
    ]));

    // ==================== 提交 / 重置 ====================

    const onSubmit = () => {
        formRef.value?.validate().then((valid: boolean) => {
            if (valid) {
                if (!agreement.value) {
                    uni.showToast({ title: t('form.agreeFirst'), icon: 'none' });
                    return;
                }
                uni.showToast({ title: t('form.submitSuccess'), icon: 'success' });
            } else {
                uni.showToast({ title: t('form.validateFail'), icon: 'none' });
            }
        });
    };

    const onReset = () => {
        formRef.value?.resetFields();
        agreement.value = false;
    };

    // ==================== 弹层：性别 / 地区 / 商品类型 ====================

    const sexPickerShow = ref<boolean>(false);
    const regionPickerShow = ref<boolean>(false);
    const goodsSelectShow = ref<boolean>(false);

    const openSexPicker = () => {
        sexPickerShow.value = true;
    };
    const openRegionPicker = () => {
        regionPickerShow.value = true;
    };
    const openGoodsSelect = () => {
        goodsSelectShow.value = true;
    };

    const sexColumns: PickerOption[][] = [
        [
            { text: t('form.sexMale'), value: 'male' },
            { text: t('form.sexFemale'), value: 'female' },
            { text: t('form.sexSecret'), value: 'secret' }
        ]
    ];
    const onSexConfirm = (event: UTSJSONObject): void => {
        const options = event['selectedOptions'] as PickerOption[];
        if (options != null && options.length > 0) {
            model.value['sex'] = options[0].text;
        }
    };

    const regionColumns: PickerOption[][] = [
        [
            {
                text: '山东省',
                children: [
                    {
                        text: '青岛市',
                        children: [{ text: '崂山区' }, { text: '市南区' }]
                    },
                    {
                        text: '济南市',
                        children: [{ text: '历下区' }, { text: '市中区' }]
                    }
                ]
            },
            {
                text: '海南省',
                children: [
                    {
                        text: '三亚市',
                        children: [{ text: '海棠区' }, { text: '吉阳区' }]
                    }
                ]
            }
        ]
    ];
    const onRegionConfirm = (event: UTSJSONObject): void => {
        const options = event['selectedOptions'] as PickerOption[];
        if (options == null || options.length === 0) return;
        let result = '';
        for (let i = 0; i < options.length; i++) {
            result += (i === 0 ? '' : '-') + options[i].text;
        }
        model.value['region'] = result;
    };

    const goodsList: SelectListItem[] = [
        { label: t('form.goodsElectronic'), value: 'electronic' },
        { label: t('form.goodsClothing'), value: 'clothing' },
        { label: t('form.goodsCraft'), value: 'craft' }
    ];
    const onGoodsConfirm = (value: UTSJSONObject[]): void => {
        if (value != null && value.length > 0) {
            const label = value[0]['label'] as string;
            if (label != null && label !== '') {
                model.value['goodsType'] = label;
            }
        }
    };

    // ==================== 参数配置 ====================

    type ConfigItem = {
        label: string;
        value: string;
    };

    const errorTypeKey = ref<string>('message');
    const errorTypeList: ConfigItem[] = [
        { label: t('form.optMessage'), value: 'message' },
        { label: t('form.optToast'), value: 'toast' },
        { label: t('form.optBorderBottom'), value: 'border-bottom' },
        { label: t('form.optBorder'), value: 'border' }
    ];
    const setErrorType = (value: string) => {
        errorTypeKey.value = value;
        errorType.value = [value as FormErrorType];
    };

    const labelPosList: ConfigItem[] = [
        { label: t('form.optLeft'), value: 'left' },
        { label: t('form.optTop'), value: 'top' }
    ];
    const setLabelPosition = (value: string) => {
        labelPosition.value = value === 'top' ? 'top' : 'left';
    };

    const sizeList: ConfigItem[] = [
        { label: t('form.optSmall'), value: 'small' },
        { label: t('form.optDefault'), value: 'default' },
        { label: t('form.optLarge'), value: 'large' }
    ];
    const setSize = (value: string) => {
        formSize.value = value;
    };
</script>

<style lang="scss">

    .form-wrap {
        margin-bottom: 12px;
    }

    .agreement {
        display: flex;
        flex-direction: row;
        align-items: center;
        margin-top: 12px;
        margin-bottom: 12px;
    }

    .btn-wrap {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-item {
        margin-right: 12px;
        margin-bottom: 12px;
    }

    .config-label {
        margin-top: 12px;
        margin-bottom: 8px;
        font-size: 14px;
        color: $u-main-color;
    }
</style>
