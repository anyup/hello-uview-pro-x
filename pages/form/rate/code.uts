/**
 * rate 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 基础用法 */
const basic = `
<template>
    <ux-rate :model-value="value" @change="onChange" />
</template>

<script setup lang="uts">
const value = ref<number>(0);

const onChange = (val: number) => {
    value.value = val;
};
</script>
`;

/** 自定义数量与尺寸 */
const count = `
<template>
    <ux-rate :count="8" :current="5" :size="22" />
</template>
`;

/** 自定义颜色与图标 */
const color = `
<template>
    <ux-rate :current="3" active-color="#ff9900" inactive-color="#c8c9cc" />
</template>
`;

/** 半星：点星星左半选半星(0.5)、右半选整星 */
const half = `
<template>
    <ux-rate :model-value="value" allow-half active-color="#fa3534" @change="onChange" />
</template>

<script setup lang="uts">
const value = ref<number>(3.5);

const onChange = (val: number) => {
    value.value = val;
};
</script>
`;

/** 禁用状态 */
const disabled = `
<template>
    <ux-rate :current="4" disabled />
</template>
`;

/** 分段颜色 */
const colors = `
<template>
    <ux-rate :model-value="value" :colors="colors" @change="onChange" />
</template>

<script setup lang="uts">
const value = ref<number>(3);
const colors: string[] = ['#2979ff', '#ff9900', '#fa3534'];

const onChange = (val: number) => {
    value.value = val;
};
</script>
`;

export const codes = {
    basic,
    count,
    color,
    half,
    disabled,
    colors
};
