/**
 * switch 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 基础用法 */
const basic = `
<template>
    <ux-switch v-model="value" />
</template>

<script setup lang="uts">
const value = ref<boolean>(true);
</script>
`;

/** 自定义值 */
const customValue = `
<template>
    <ux-switch v-model="value" :active-value="100" :inactive-value="1" />
    <text>当前值: {{ value }}</text>
</template>

<script setup lang="uts">
const value = ref<number>(1);
</script>
`;

/** 颜色配置 */
const color = `
<template>
    <ux-switch v-model="value" active-color="#19be6b" />
</template>

<script setup lang="uts">
const value = ref<boolean>(true);
</script>
`;

/** 尺寸配置 */
const size = `
<template>
    <ux-switch v-model="value" size="large" />
</template>

<script setup lang="uts">
const value = ref<boolean>(true);
</script>
`;

/** 加载中 */
const loading = `
<template>
    <ux-switch v-model="value" :loading="true" />
</template>

<script setup lang="uts">
const value = ref<boolean>(true);
</script>
`;

/** 禁用 */
const disabled = `
<template>
    <ux-switch v-model="value" :disabled="true" />
</template>

<script setup lang="uts">
const value = ref<boolean>(true);
</script>
`;

export const codes = {
    basic,
    customValue,
    color,
    size,
    loading,
    disabled
};
