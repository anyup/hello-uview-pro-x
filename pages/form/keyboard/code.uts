<template>
    <ux-button type="primary" shape="round" text="打开身份证键盘" @click="open" />
    <ux-keyboard v-model="show" mode="card" @change="onChange" @confirm="onConfirm" />
    <ux-toast ref="toastRef" />
</template>

<script setup lang="uts">
const toastRef = ref<any>();
const show = ref(false);
