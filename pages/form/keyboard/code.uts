/**
 * keyboard 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 数字键盘 */
const number = `
<template>
    <view class="keyboard-display">
        <text>{{ inputValue.length > 0 ? inputValue : '请点击按钮唤起键盘' }}</text>
    </view>
    <ux-button type="primary" shape="round" text="打开数字键盘" @click="open" />
    <ux-keyboard v-model="show" mode="number" @change="onChange" @backspace="onBackspace" @confirm="onConfirm" @cancel="onCancel" />
    <ux-toast ref="toastRef" />
</template>

<script setup lang="uts">
const toastRef = ref<any>();
const show = ref(false);
const inputValue = ref('');

const open = () => {
    show.value = true;
};

const keyToString = (key: string | number): string => {
    return typeof key == 'number' ? (key as number).toString() : key as string;
};

const onChange = (key: string | number) => {
    inputValue.value = inputValue.value + keyToString(key);
};

const onBackspace = () => {
    inputValue.value = inputValue.length > 0 ? inputValue.substring(0, inputValue.length - 1) : '';
};

const onConfirm = () => {
    toastRef.value?.show?.({ title: '输入完成：' + inputValue.value, type: 'success', duration: 2000 });
};

const onCancel = () => {
    toastRef.value?.show?.({ title: '已取消输入', type: 'info', duration: 2000 });
};
</script>

<style scoped>
.keyboard-display {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12px 15px;
    border-radius: 6px;
    background-color: #f8f8f8;
    margin-bottom: 12px;
}
</style>
`;

