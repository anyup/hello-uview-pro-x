const open = () => {
    show.value = true;
};

const onChange = (key: string | number) => {
    inputValue.value = inputValue.value + (typeof key == 'number' ? (key as number).toString() : key as string);
};

const onConfirm = () => {
    toastRef.value?.show?.({ title: '输入完成：' + inputValue.value, type: 'success', duration: 2000 });
