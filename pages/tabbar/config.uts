// ===================== 关于页 =====================

/** 关于页信息行（文案与值均为 i18n key，空字符串表示该位不渲染） */
export type InfoRow = {
    /** 主标题 */
    name: string;
    /** 右侧值（与 desc 二选一） */
    value: string;
    /** 副标题描述（与 value 二选一） */
    desc: string;
};

/** 关于页版本信息 */
export const aboutVersionRows: InfoRow[] = [
    { name: 'tabbarAbout.versionLabel', value: 'tabbarAbout.versionValue', desc: '' },
    { name: 'tabbarAbout.engineLabel', value: 'tabbarAbout.engineValue', desc: '' },
    { name: 'tabbarAbout.renderLabel', value: 'tabbarAbout.renderValue', desc: '' },
    { name: 'tabbarAbout.languageLabel', value: 'tabbarAbout.languageValue', desc: '' }
];

/** 关于页能力特性 */
export const aboutFeatureRows: InfoRow[] = [
    { name: 'tabbarAbout.featureVapor', value: '', desc: 'tabbarAbout.featureVaporDesc' },
    { name: 'tabbarAbout.featureIsolation', value: '', desc: 'tabbarAbout.featureIsolationDesc' },
    { name: 'tabbarAbout.featureLanguage', value: '', desc: 'tabbarAbout.featureLanguageDesc' },
    { name: 'tabbarAbout.featureTheme', value: '', desc: 'tabbarAbout.featureThemeDesc' },
    { name: 'tabbarAbout.featureLocale', value: '', desc: 'tabbarAbout.featureLocaleDesc' },
    { name: 'tabbarAbout.featureEasycom', value: '', desc: 'tabbarAbout.featureEasycomDesc' }
];
