/**
 * TabBar 页面共享配置
 * 数据驱动 3 个 TabBar 页面渲染，便于维护和扩展
 */

/** 菜单项 */
export type MenuItem = {
    /** 显示名称 */
    name: string;
    /** 中文名称（用于搜索匹配） */
    zhName?: string;
    /** 描述文字 */
    desc: string;
    /** 图标文字（取首字母，显示在彩色圆形图标中） */
    icon: string;
    /** 跳转路径（不含 /pages/ 前缀） */
    path: string;
};

/** 菜单分类 */
export type MenuCategory = {
    /** 分类名称 */
    name: string;
    /** 分类图标文字 */
    icon: string;
    /** 子项列表 */
    items: MenuItem[];
};

