/**
 * safeBottom 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 基础用法 */
const basic = `
<template>
    <view class="content">
        <text>内容区域</text>
    </view>
    <!-- 自动适配底部安全区，非全面屏机型高度为 0 -->
    <ux-safe-bottom />
</template>

<style scoped>
.content {
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f2f3f5;
    border-radius: 8px;
}
</style>
`;

/** 自定义样式 */
const customStyle = `
<template>
    <view class="content">
        <text>内容区域</text>
    </view>
    <ux-safe-bottom :custom-style="{ backgroundColor: '#f56c6c' }" />
</template>

<style scoped>
.content {
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f2f3f5;
    border-radius: 8px;
}
</style>
`;

/** 自定义类名 */
const customClass = `
<template>
    <view class="content">
        <text>内容区域</text>
    </view>
    <ux-safe-bottom custom-class="custom-safe-bottom" />
</template>

<style scoped>
.content {
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f2f3f5;
    border-radius: 8px;
}
.custom-safe-bottom {
    background-color: #2979ff;
}
</style>
`;

export const codes = {
    basic,
    customStyle,
    customClass
};
