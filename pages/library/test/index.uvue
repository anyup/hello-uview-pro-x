<template>
    <demo-page :title="t('test.title')" :subtitle="t('test.subtitle')">
        <!-- 类型判断 -->
        <demo-block :title="t('test.typeTitle')" :code="codes.type">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in typeList"
                    :key="index"
                    :title="item.desc"
                    :arrow="false"
                    :border-bottom="!item.last"
                >
                    <ux-tag
                        size="mini"
                        :type="item.result ? 'success' : 'error'"
                        :text="item.result ? 'true' : 'false'"
                    />
                </ux-cell-item>
            </ux-cell-group>
        </demo-block>

        <!-- 数字判断 -->
        <demo-block :title="t('test.numberTitle')" :code="codes.number">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in numberList"
                    :key="index"
                    :title="item.desc"
                    :arrow="false"
                    :border-bottom="!item.last"
                >
                    <ux-tag
                        size="mini"
                        :type="item.result ? 'success' : 'error'"
                        :text="item.result ? 'true' : 'false'"
                    />
                </ux-cell-item>
            </ux-cell-group>
        </demo-block>

        <!-- 字符串判断 -->
        <demo-block :title="t('test.stringTitle')" :code="codes.string">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in stringList"
                    :key="index"
                    :title="item.desc"
                    :arrow="false"
                    :border-bottom="!item.last"
                >
                    <ux-tag
                        size="mini"
                        :type="item.result ? 'success' : 'error'"
                        :text="item.result ? 'true' : 'false'"
                    />
                </ux-cell-item>
            </ux-cell-group>
        </demo-block>

        <!-- 证件与号码校验 -->
        <demo-block :title="t('test.regexTitle')" :code="codes.regex">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in regexList"
                    :key="index"
                    :title="item.desc"
                    :arrow="false"
                    :border-bottom="!item.last"
                >
                    <ux-tag
                        size="mini"
                        :type="item.result ? 'success' : 'error'"
                        :text="item.result ? 'true' : 'false'"
                    />
                </ux-cell-item>
            </ux-cell-group>
        </demo-block>

        <!-- 结构与类型判定 -->
        <demo-block :title="t('test.structTitle')" :desc="t('test.structDesc')" :code="codes.struct">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in structList"
                    :key="index"
                    :title="item.desc"
                    :arrow="false"
                    :border-bottom="!item.last"
                >
                    <ux-tag
                        size="mini"
                        :type="item.result ? 'success' : 'error'"
                        :text="item.result ? 'true' : 'false'"
                    />
                </ux-cell-item>
            </ux-cell-group>
        </demo-block>

        <!-- 媒体与渐变 -->
        <demo-block :title="t('test.mediaTitle')" :code="codes.media">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in mediaList"
                    :key="index"
                    :title="item.desc"
                    :arrow="false"
                    :border-bottom="!item.last"
                >
                    <ux-tag
                        size="mini"
                        :type="item.result ? 'success' : 'error'"
                        :text="item.result ? 'true' : 'false'"
                    />
                </ux-cell-item>
            </ux-cell-group>
        </demo-block>

        <!-- 空值判断 -->
        <demo-block :title="t('test.emptyTitle')" :code="codes.empty">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in emptyList"
                    :key="index"
                    :title="item.desc"
                    :arrow="false"
                    :border-bottom="!item.last"
                >
                    <ux-tag
                        size="mini"
                        :type="item.result ? 'success' : 'error'"
                        :text="item.result ? 'true' : 'false'"
                    />
                </ux-cell-item>
            </ux-cell-group>
        </demo-block>
    </demo-page>
</template>

<script setup lang="uts">
    import { $u, useLocale } from '@/uni_modules/uview-pro-x';
    import { codes } from './code';

    const { t } = useLocale('demo');

    type TestItem = {
        desc: string;
        result: boolean;
        last: boolean;
    };

    const typeList: TestItem[] = [
        { desc: '$u.test.string("hello")', result: $u.test.string('hello'), last: false },
        { desc: '$u.test.number("123")', result: $u.test.number('123'), last: false },
        { desc: '$u.test.array([1,2,3])', result: $u.test.array([1, 2, 3]), last: false },
        { desc: '$u.test.object({})', result: $u.test.object({}), last: false },
        { desc: '$u.test.func(() => {})', result: $u.test.func((): void => {}), last: true }
    ];

    const numberList: TestItem[] = [
        { desc: '$u.test.number("123")', result: $u.test.number('123'), last: false },
        { desc: '$u.test.number("-12.34")', result: $u.test.number('-12.34'), last: false },
        { desc: '$u.test.number("12a")', result: $u.test.number('12a'), last: false },
        { desc: '$u.test.digits("123")', result: $u.test.digits('123'), last: false },
        { desc: '$u.test.digits("12.3")', result: $u.test.digits('12.3'), last: false },
        { desc: '$u.test.range(5, 1, 10)', result: $u.test.range(5, 1, 10), last: false },
        { desc: '$u.test.range(15, 1, 10)', result: $u.test.range(15, 1, 10), last: true }
    ];

    const stringList: TestItem[] = [
        { desc: '$u.test.email("user@example.com")', result: $u.test.email('user@example.com'), last: false },
        { desc: '$u.test.mobile("13800138000")', result: $u.test.mobile('13800138000'), last: false },
        { desc: '$u.test.url("https://www.example.com")', result: $u.test.url('https://www.example.com'), last: false },
        { desc: '$u.test.chinese("' + t('test.chineseTestData') + '")', result: $u.test.chinese(t('test.chineseTestData')), last: false },
        { desc: '$u.test.letter("abc")', result: $u.test.letter('abc'), last: false },
        { desc: '$u.test.letter("abc123")', result: $u.test.letter('abc123'), last: false },
        { desc: '$u.test.contains("hello world", "world")', result: $u.test.contains('hello world', 'world'), last: false },
        { desc: '$u.test.rangeLength("hello", 2, 10)', result: $u.test.rangeLength('hello', 2, 10), last: true }
    ];

    const regexList: TestItem[] = [
        { desc: '$u.test.idCard("110101199003077777")', result: $u.test.idCard('110101199003077777'), last: false },
        { desc: '$u.test.idCard("12345")', result: $u.test.idCard('12345'), last: false },
        { desc: '$u.test.landline("010-12345678")', result: $u.test.landline('010-12345678'), last: false },
        { desc: '$u.test.landline("010-1234")', result: $u.test.landline('010-1234'), last: false },
        { desc: '$u.test.amount("1,234.56")', result: $u.test.amount('1,234.56'), last: false },
        { desc: '$u.test.amount("1234.567")', result: $u.test.amount('1234.567'), last: false },
        { desc: '$u.test.amount("0.5")', result: $u.test.amount('0.5'), last: true }
    ];

    const structList: TestItem[] = [
        { desc: '$u.test.null(null)', result: $u.test.null(null), last: false },
        { desc: '$u.test.null("")', result: $u.test.null(''), last: false },
        { desc: '$u.test.code("123456", null)', result: $u.test.code('123456', null), last: false },
        { desc: '$u.test.code("1234", 4)', result: $u.test.code('1234', 4), last: false },
        { desc: '$u.test.code("123", null)', result: $u.test.code('123', null), last: false },
        { desc: '$u.test.enOrNum("abc123")', result: $u.test.enOrNum('abc123'), last: false },
        { desc: '$u.test.enOrNum("abc-123")', result: $u.test.enOrNum('abc-123'), last: false },
        { desc: '$u.test.enOrNum("")', result: $u.test.enOrNum(''), last: true }
    ];

    const mediaList: TestItem[] = [
        { desc: '$u.test.image("https://a.com/x.png?v=1")', result: $u.test.image('https://a.com/x.png?v=1'), last: false },
        { desc: '$u.test.image("a.pdf")', result: $u.test.image('a.pdf'), last: false },
        { desc: '$u.test.video("a.mp4")', result: $u.test.video('a.mp4'), last: false },
        { desc: '$u.test.video("a.m3u8")', result: $u.test.video('a.m3u8'), last: false },
        { desc: '$u.test.video("a.txt")', result: $u.test.video('a.txt'), last: false },
        { desc: '$u.test.gradientColor("linear-gradient(90deg, #fff, #000)")', result: $u.test.gradientColor('linear-gradient(90deg, #fff, #000)'), last: false },
        { desc: '$u.test.gradientColor("#fff")', result: $u.test.gradientColor('#fff'), last: true }
    ];

    const emptyList: TestItem[] = [
        { desc: '$u.test.empty(null)', result: $u.test.empty(null), last: false },
        { desc: '$u.test.empty("")', result: $u.test.empty(''), last: false },
        { desc: '$u.test.empty([])', result: $u.test.empty([] as any[]), last: false },
        { desc: '$u.test.empty(0)', result: $u.test.empty(0), last: false },
        { desc: '$u.test.empty("hello")', result: $u.test.empty('hello'), last: true }
    ];
</script>

<style lang="scss">
    /* 样式由 demo-page 组件提供 */
</style>
