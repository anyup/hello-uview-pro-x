/**
 * debounce 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 普通点击 */
const normal = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="点击次数" :value="clickCount" :arrow="false" />
        <ux-cell-item title="最近点击时间" :value="lastClickTime.length > 0 ? lastClickTime : '-'" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="普通点击" @click="onClick()" />
</template>

<script setup lang="uts">
const clickCount = ref(0);
const lastClickTime = ref('');

function onClick(): void {
    clickCount.value++;
    lastClickTime.value = new Date().toLocaleTimeString();
}
</script>
`;

/** 防抖对比 */
const debounce = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="触发次数" :value="clickCount" :arrow="false" />
        <ux-cell-item title="实际执行次数" :value="executeCount" :arrow="false" />
        <ux-cell-item title="最近执行时间" :value="lastExecuteTime.length > 0 ? lastExecuteTime : '-'" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="防抖点击（500ms）" @click="onClick()" />
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';

const clickCount = ref(0);
const executeCount = ref(0);
const lastExecuteTime = ref('');

// 防抖函数只创建一次，跨点击复用
const debouncedFn = $u.debounce((): void => {
    executeCount.value++;
    lastExecuteTime.value = new Date().toLocaleTimeString();
}, 500, false);

function onClick(): void {
    clickCount.value++;
    debouncedFn();
}
</script>
`;

/** 立即执行 */
const immediate = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="实际执行次数" :value="executeCount" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="立即执行（500ms）" @click="onClick()" />
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';

const executeCount = ref(0);

// immediate 为 true：首次点击立即执行，等待期内的后续点击被丢弃
const immediateFn = $u.debounce((): void => {
    executeCount.value++;
}, 500, true);

function onClick(): void {
    immediateFn();
}
</script>
`;

export const codes = {
    normal,
    debounce,
    immediate
};