<script setup lang="uts">
import { $u, useLocale } from '@/uni_modules/uview-pro-x';

const { t } = useLocale('demo');

const clickCount = ref(0);
const debounceCount = ref(0);
const lastClickTime = ref('');
const lastExecuteTime = ref('');

// 普通点击
const handleNormalClick = () => {
    clickCount.value++;
    lastClickTime.value = new Date().toLocaleTimeString();
};

// 创建防抖函数（只创建一次）
const debouncedFn = $u.debounce(() => {
    debounceCount.value++;
    lastExecuteTime.value = new Date().toLocaleTimeString();
}, 500, false);

// 防抖点击
const handleDebounceClick = () => {
    handleNormalClick();
    debouncedFn();
};

// 立即执行版本
const immediateCount = ref(0);
const immediateFn = $u.debounce(() => {
    immediateCount.value++;
}, 500, true);

const handleImmediateClick = () => {
    handleNormalClick();
    immediateFn();
};
</script>

<template>
    <demo-page :title="t('debounce.title')" :subtitle="t('debounce.subtitle')">
        <!-- 普通点击 -->
        <demo-block :title="t('debounce.normalTitle')">
            <view class="demo-item demo-item--last">
                <text class="demo-desc">{{ t('debounce.normalClickCount') }}{{ clickCount }}</text>
                <text class="demo-desc">{{ t('debounce.normalLastClick') }}{{ lastClickTime.length > 0 ? lastClickTime : '-' }}</text>
            </view>
            <view class="demo-btn debounce-btn" @click="handleNormalClick">
                <text>{{ t('debounce.normalBtn') }}</text>
            </view>
        </demo-block>

        <!-- 防抖对比 -->
        <demo-block :title="t('debounce.debounceTitle')">
            <view class="demo-item demo-item--last">
                <text class="demo-desc">{{ t('debounce.debounceTriggerCount') }}{{ clickCount }}</text>
                <text class="demo-desc">{{ t('debounce.debounceActualExec') }}{{ debounceCount }}</text>
                <text class="demo-desc">{{ t('debounce.debounceLastExec') }}{{ lastExecuteTime.length > 0 ? lastExecuteTime : '-' }}</text>
            </view>
            <view class="demo-btn debounce-btn" @click="handleDebounceClick">
                <text>{{ t('debounce.debounceBtn') }}</text>
            </view>
        </demo-block>

        <!-- 立即执行 -->
        <demo-block :title="t('debounce.immediateTitle')">
            <view class="demo-item demo-item--last">
                <text class="demo-desc">{{ t('debounce.immediateCount') }}{{ immediateCount }}</text>
            </view>
            <view class="demo-btn debounce-btn" @click="handleImmediateClick">
                <text>{{ t('debounce.immediateBtn') }}</text>
            </view>
        </demo-block>

        <!-- 方法说明 -->
        <demo-block :title="t('debounce.usageTitle')">
            <view class="demo-item demo-item--last">
                <text class="demo-desc">const fn = $u.debounce(func, wait, immediate)</text>
                <text class="demo-desc">{{ t('debounce.usageFunc') }}</text>
                <text class="demo-desc">{{ t('debounce.usageWait') }}</text>
                <text class="demo-desc">{{ t('debounce.usageImmediate') }}</text>
                <text class="demo-desc">{{ t('debounce.usageReturn') }}</text>
            </view>
        </demo-block>
    </demo-page>
</template>

<style lang="scss">
/* 使用全局 demo.scss 样式 */

/* 区块内按钮：去掉全局 margin-bottom，与 demo-block 底部留白对齐 */
.debounce-btn {
    margin-bottom: 0;
}
</style>
