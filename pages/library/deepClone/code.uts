/**
 * deepClone 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 对象深克隆 */
const object = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="原对象" :label="JSON.stringify(originalObj)" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="克隆对象" @click="handleClone()" />
    <template v-if="clonedObj != null">
        <ux-gap :height="8" />
        <ux-cell-group :border="false">
            <ux-cell-item title="克隆对象" :label="JSON.stringify(clonedObj)" :arrow="false" />
            <ux-cell-item title="是否同一引用" :arrow="false">
                <ux-tag size="mini" :type="isSameRef ? 'error' : 'success'" :text="isSameRef ? '是' : '否'" />
            </ux-cell-item>
            <ux-cell-item title="内容是否相等" :arrow="false" :border-bottom="false">
                <ux-tag size="mini" :type="isDeepEqual ? 'success' : 'error'" :text="isDeepEqual ? '是' : '否'" />
            </ux-cell-item>
        </ux-cell-group>
    </template>
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';

const originalObj = ref<UTSJSONObject>({
    name: '张三',
    age: 25,
    address: { city: '北京', district: '朝阳区' }
});
const clonedObj = ref<UTSJSONObject | null>(null);
const isSameRef = ref<boolean>(false);
const isDeepEqual = ref<boolean>(false);

function handleClone(): void {
    clonedObj.value = $u.deepClone(originalObj.value);
    isSameRef.value = originalObj.value === clonedObj.value;
    isDeepEqual.value = JSON.stringify(originalObj.value) === JSON.stringify(clonedObj.value);
}
</script>
`;

/** 数组深克隆 */
const array = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="原数组" :label="JSON.stringify(originalArr)" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="克隆数组" @click="handleCloneArray()" />
    <template v-if="clonedArr.length > 0">
        <ux-gap :height="8" />
        <ux-cell-group :border="false">
            <ux-cell-item title="克隆数组" :label="JSON.stringify(clonedArr)" :arrow="false" :border-bottom="false" />
        </ux-cell-group>
    </template>
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';

const originalArr = ref<any[]>([1, 2, { a: 3 }]);
const clonedArr = ref<any[]>([]);

function handleCloneArray(): void {
    clonedArr.value = $u.deepClone(originalArr.value);
}
</script>
`;

export const codes = {
    object,
    array
};