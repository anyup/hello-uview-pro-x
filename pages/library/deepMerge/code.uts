/**
 * deepMerge 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 基本合并 */
const basic = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="目标对象" :label="JSON.stringify(targetObj)" :arrow="false" />
        <ux-cell-item title="源对象" :label="JSON.stringify(sourceObj)" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="执行合并" @click="handleMerge()" />
    <template v-if="mergedObj != null">
        <ux-gap :height="8" />
        <ux-cell-group :border="false">
            <ux-cell-item title="合并结果" :label="JSON.stringify(mergedObj)" :arrow="false" :border-bottom="false" />
        </ux-cell-group>
    </template>
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';

const targetObj = ref<UTSJSONObject>({
    name: '张三',
    age: 25,
    address: { city: '北京', district: '朝阳区' }
});
const sourceObj = ref<UTSJSONObject>({
    age: 30,
    email: 'zhangsan@example.com',
    address: { city: '上海', street: '南京路' }
});
const mergedObj = ref<UTSJSONObject | null>(null);

function handleMerge(): void {
    mergedObj.value = $u.deepMerge(targetObj.value, sourceObj.value);
}
</script>
`;

/** 数组合并 */
const array = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="目标" :value="JSON.stringify(targetArr)" :arrow="false" />
        <ux-cell-item title="源" :value="JSON.stringify(sourceArr)" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="合并数组" @click="handleMergeArray()" />
    <template v-if="mergedArr != null">
        <ux-gap :height="8" />
        <ux-cell-group :border="false">
            <ux-cell-item title="结果" :value="JSON.stringify(mergedArr)" :arrow="false" :border-bottom="false" />
        </ux-cell-group>
    </template>
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';

const targetArr = ref<UTSJSONObject>({ items: [1, 2] });
const sourceArr = ref<UTSJSONObject>({ items: [3, 4] });
const mergedArr = ref<UTSJSONObject | null>(null);

function handleMergeArray(): void {
    mergedArr.value = $u.deepMerge(targetArr.value, sourceArr.value);
}
</script>
`;

/** 嵌套对象合并 */
const nested = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="目标" :label="JSON.stringify(complexTarget)" :arrow="false" />
        <ux-cell-item title="源" :label="JSON.stringify(complexSource)" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="嵌套合并" @click="handleComplexMerge()" />
    <template v-if="complexMerged != null">
        <ux-gap :height="8" />
        <ux-cell-group :border="false">
            <ux-cell-item title="结果" :label="JSON.stringify(complexMerged)" :arrow="false" :border-bottom="false" />
        </ux-cell-group>
    </template>
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';

const complexTarget = ref<UTSJSONObject>({
    user: { profile: { name: '张三', settings: { theme: 'light' } } }
});
const complexSource = ref<UTSJSONObject>({
    user: { profile: { settings: { language: 'zh-CN' } } }
});
const complexMerged = ref<UTSJSONObject | null>(null);

function handleComplexMerge(): void {
    complexMerged.value = $u.deepMerge(complexTarget.value, complexSource.value);
}
</script>
`;

export const codes = {
    basic,
    array,
    nested
};