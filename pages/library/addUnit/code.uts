`;

/** 多值场景 */
const multi = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="$u.addUnit('10 20')" :value="$u.addUnit('10 20')" :arrow="false" />
        <ux-cell-item title="$u.addUnit('10px 20')" :value="$u.addUnit('10px 20')" :arrow="false" />
        <ux-cell-item title="$u.addUnit('10 10px 30')" :value="$u.addUnit('10 10px 30')" :arrow="false" />
        <ux-cell-item title="$u.addUnit('auto 10')" :value="$u.addUnit('auto 10')" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';
