<template>
    <demo-page :title="t('throttle.title')" :subtitle="t('throttle.subtitle')">
        <!-- 普通点击 -->
        <demo-block :title="t('throttle.normalTitle')" :code="codes.normal">
            <ux-cell-group :border="false">
                <ux-cell-item :title="t('throttle.clickCount')" :value="clickCount" :arrow="false" :border-bottom="false" />
            </ux-cell-group>
            <ux-gap :height="8" />
            <ux-button size="small" type="primary" block :text="t('throttle.normalBtn')" @click="handleNormalClick()" />
        </demo-block>

        <!-- 节流对比 -->
        <demo-block :title="t('throttle.throttleTitle')" :code="codes.throttle">
            <ux-cell-group :border="false">
                <ux-cell-item :title="t('throttle.triggerCount')" :value="clickCount" :arrow="false" />
                <ux-cell-item :title="t('throttle.actualExec')" :value="throttleCount" :arrow="false" />
                <ux-cell-item :title="t('throttle.lastExec')" :value="lastExecuteTime.length > 0 ? lastExecuteTime : '-'" :arrow="false" :border-bottom="false" />
            </ux-cell-group>
            <ux-gap :height="8" />
            <ux-button size="small" type="primary" block :text="t('throttle.throttleBtn')" @click="handleThrottleClick()" />
        </demo-block>

        <!-- 延迟执行 -->
        <demo-block :title="t('throttle.delayTitle')" :code="codes.delay">
            <ux-cell-group :border="false">
                <ux-cell-item :title="t('throttle.delayCount')" :value="delayCount" :arrow="false" :border-bottom="false" />
            </ux-cell-group>
            <ux-gap :height="8" />
            <ux-button size="small" type="primary" block :text="t('throttle.delayBtn')" @click="handleDelayClick()" />
        </demo-block>

        <!-- 使用说明 -->
        <demo-block :title="t('throttle.usageTitle')">
            <ux-alert-tips type="primary" :show-icon="true" :title="t('throttle.usageFunc')" description="const fn = $u.throttle(func, wait, immediate)" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('throttle.usageWait')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('throttle.usageImmediate')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('throttle.usageReturn')" />
        </demo-block>
    </demo-page>
</template>

<script setup lang="uts">
    import { $u, useLocale } from '@/uni_modules/uview-pro-x';
    import { codes } from './code';

    const { t } = useLocale('demo');

    const clickCount = ref(0);
    const throttleCount = ref(0);
    const lastExecuteTime = ref('');
    const delayCount = ref(0);

    /** 记录一次普通点击 */
    function recordClick(): void {
        clickCount.value++;
    }

    /** 1000ms 立即执行的节流函数（只创建一次，跨点击复用） */
    const throttledFn = $u.throttle((): void => {
        throttleCount.value++;
        lastExecuteTime.value = new Date().toLocaleTimeString();
    }, 1000, true);

    /** 1000ms 延迟执行的节流函数 */
    const delayFn = $u.throttle((): void => {
        delayCount.value++;
    }, 1000, false);

    /** 普通点击：不节流，每次都计数 */
    function handleNormalClick(): void {
        recordClick();
    }

    /** 节流点击：1000ms 内只执行第一次 */
    function handleThrottleClick(): void {
        recordClick();
        throttledFn();
    }

    /** 延迟执行：1000ms 后执行最后一次触发 */
    function handleDelayClick(): void {
        recordClick();
        delayFn();
    }
</script>

<style lang="scss">
    /* 样式由 demo-page 组件提供 */
</style>
