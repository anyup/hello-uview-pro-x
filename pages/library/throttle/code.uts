/**
 * throttle 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 普通点击 */
const normal = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="点击次数" :value="clickCount" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="普通点击" @click="onClick()" />
</template>

<script setup lang="uts">
const clickCount = ref(0);

function onClick(): void {
    clickCount.value++;
}
</script>
`;

/** 节流对比 */
const throttle = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="触发次数" :value="clickCount" :arrow="false" />
        <ux-cell-item title="实际执行次数" :value="executeCount" :arrow="false" />
        <ux-cell-item title="最近执行时间" :value="lastExecuteTime.length > 0 ? lastExecuteTime : '-'" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="节流点击（1000ms）" @click="onClick()" />
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';

const clickCount = ref(0);
const executeCount = ref(0);
const lastExecuteTime = ref('');

// 节流函数只创建一次，跨点击复用；immediate 为 true 表示窗口起点先执行
const throttledFn = $u.throttle((): void => {
    executeCount.value++;
    lastExecuteTime.value = new Date().toLocaleTimeString();
}, 1000, true);

function onClick(): void {
    clickCount.value++;
    throttledFn();
}
</script>
`;

/** 延迟执行 */
const delay = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="实际执行次数" :value="executeCount" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
    <ux-gap :height="8" />
    <ux-button size="small" type="primary" block text="延迟执行（1000ms）" @click="onClick()" />
</template>

<script setup lang="uts">
import { $u } from '@/uni_modules/uview-pro-x';

const executeCount = ref(0);

// immediate 为 false：窗口结束时执行一次
const delayFn = $u.throttle((): void => {
    executeCount.value++;
}, 1000, false);

function onClick(): void {
    delayFn();
}
</script>
`;

export const codes = {
    normal,
    throttle,
    delay
};