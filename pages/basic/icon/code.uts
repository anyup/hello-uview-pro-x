        <ux-icon name="https://ik.imagekit.io/anyup/uview-pro/logo/uviewprox.png" img-mode="aspectFit" width="30" height="30" custom-class="icon-spacing"></ux-icon>
    </view>
</template>

<style scoped>
.icon-row {
    display: flex;
