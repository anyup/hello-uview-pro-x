    <view class="icon-row">
        <ux-icon name="star-fill" size="20" type="primary" custom-class="icon-spacing"></ux-icon>
        <ux-icon name="heart-fill" size="20" type="success" custom-class="icon-spacing"></ux-icon>
        <ux-icon name="bell-fill" size="20" type="error" custom-class="icon-spacing"></ux-icon>
        <ux-icon name="setting-fill" size="20" type="warning" custom-class="icon-spacing"></ux-icon>
