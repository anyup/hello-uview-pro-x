    <view class="icon-row">
        <ux-icon name="home" size="15" color="#2979ff" custom-class="icon-spacing"></ux-icon>
        <ux-icon name="home" size="20" color="#2979ff" custom-class="icon-spacing"></ux-icon>
        <ux-icon name="home" size="25" color="#2979ff" custom-class="icon-spacing"></ux-icon>
        <ux-icon name="home" size="30" color="#2979ff" custom-class="icon-spacing"></ux-icon>
