/** 基础用法 */
const grid = `
<template>
    <view class="icon-grid">
        <view class="icon-item" v-for="(item, index) in iconList" :key="index">
            <ux-icon :name="item.name" size="20" color="#909399"></ux-icon>
            <text class="icon-name">{{ item.name }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
const iconList = [
    { name: 'home' },
    { name: 'star' },
    { name: 'search' },
    { name: 'setting' },
    { name: 'phone' },
    { name: 'heart' }
];
</script>

<style scoped>
.icon-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}
.icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 33.33%;
    padding: 12px 0;
}
.icon-name {
    font-size: 11px;
    color: #909399;
    margin-top: 6px;
}
</style>
`;

/** 尺寸与颜色 */
const custom = `
