/**
 * badge 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 * 覆盖说明：包裹用法把内容放进默认插槽，组件自带定位锚点（relative + overflow:visible），
 * 无需再手动加 position:relative 的宿主容器，App/H5/小程序三端通用。
 */

/** 基础用法 */
const basic = `
<template>
    <view class="row">
        <ux-badge :count="5" custom-class="badge-item">
            <view class="box"><text class="text">消息</text></view>
        </ux-badge>
        <ux-badge :count="99" custom-class="badge-item">
            <view class="box"><text class="text">消息</text></view>
        </ux-badge>
        <ux-badge :count="200" custom-class="badge-item">
            <view class="box"><text class="text">消息</text></view>
        </ux-badge>
    </view>
</template>

<style scoped>
.row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    overflow: visible;
}
.badge-item {
    margin-right: 20px;
    margin-bottom: 15px;
}
.box {
    width: 60px;
    height: 60px;
    background-color: #f7f8fa;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.text {
    font-size: 13px;
    color: #909399;
}
</style>
`;

/** 预设类型 */
const type = `
<template>
    <view class="row">
        <ux-badge
            v-for="(item, index) in typeList"
            :key="index"
            :type="item.type"
            :count="8"
            custom-class="badge-item"
        >
            <view class="box"><text class="text">{{ item.label }}</text></view>
        </ux-badge>
    </view>
</template>

<script setup lang="uts">
const typeList = [
    { type: 'error', label: 'error' },
    { type: 'primary', label: 'primary' },
    { type: 'success', label: 'success' },
    { type: 'warning', label: 'warning' },
    { type: 'info', label: 'info' }
];
</script>

<style scoped>
.row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    overflow: visible;
}
.badge-item {
    margin-right: 20px;
    margin-bottom: 15px;
}
.box {
    width: 60px;
    height: 60px;
    background-color: #f7f8fa;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.text {
    font-size: 13px;
    color: #909399;
}
</style>
`;

/** 圆点模式 */
const dot = `
<template>
    <view class="row">
        <ux-badge :is-dot="true" is-center custom-class="badge-item">
            <view class="box"><text class="text">消息</text></view>
        </ux-badge>
        <ux-badge :is-dot="true" type="primary" is-center custom-class="badge-item">
            <view class="box"><text class="text">通知</text></view>
        </ux-badge>
        <ux-badge :is-dot="true" type="warning" is-center custom-class="badge-item">
            <view class="box"><text class="text">提醒</text></view>
        </ux-badge>
    </view>
</template>

<style scoped>
.row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    overflow: visible;
}
.badge-item {
    margin-right: 20px;
    margin-bottom: 15px;
}
.box {
    width: 60px;
    height: 60px;
    background-color: #f7f8fa;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.text {
    font-size: 13px;
    color: #909399;
}
</style>
`;

