<template>
    <demo-page :title="t('steps.title')" :subtitle="t('steps.subtitle')">

        <demo-block :title="t('steps.dotTitle')" :desc="t('steps.dotDesc')" :code="codes.dot">
            <ux-steps :current="current1">
                <ux-step :name="t('steps.step1')" />
                <ux-step :name="t('steps.step2')" />
                <ux-step :name="t('steps.step3')" />
            </ux-steps>
        </demo-block>

        <demo-block :title="t('steps.numberTitle')" :desc="t('steps.numberDesc')" :code="codes.number">
            <ux-steps mode="number" :current="current2">
                <ux-step :name="t('steps.step1')" />
                <ux-step :name="t('steps.step2')" />
                <ux-step :name="t('steps.step3')" />
                <ux-step :name="t('steps.step4')" />
            </ux-steps>
        </demo-block>

        <demo-block :title="t('steps.verticalTitle')" :desc="t('steps.verticalDesc')" :code="codes.vertical">
            <ux-steps direction="column" :current="current3">
                <ux-step :name="t('steps.step1')" :desc="t('steps.step1Desc')" />
                <ux-step :name="t('steps.step2')" :desc="t('steps.step2Desc')" />
                <ux-step :name="t('steps.step3')" :desc="t('steps.step3Desc')" />
            </ux-steps>
        </demo-block>

        <demo-block :title="t('steps.colorTitle')" :desc="t('steps.colorDesc')" :code="codes.color">
            <ux-steps mode="number" :current="current4" active-color="#fa3534" inactive-color="#909399">
                <ux-step :name="t('steps.step1')" />
                <ux-step :name="t('steps.step2')" />
                <ux-step :name="t('steps.step3')" />
            </ux-steps>
        </demo-block>

        <demo-block :title="t('steps.controlTitle')" :desc="t('steps.controlDesc')" :code="codes.control">
            <ux-steps mode="number" :current="current5">
                <ux-step :name="t('steps.step1')" />
                <ux-step :name="t('steps.step2')" />
                <ux-step :name="t('steps.step3')" />
            </ux-steps>
            <view class="demo-btn-row">
                <ux-button custom-class="demo-btn-item" size="small" shape="round" @click="prevStep" :disabled="current5 === 0">{{ t('steps.prev') }}</ux-button>
                <ux-button size="small" shape="round" type="primary" @click="nextStep" :disabled="current5 === 2">{{ t('steps.next') }}</ux-button>
            </view>
        </demo-block>

        <demo-block :title="t('steps.dynamicTitle')" :desc="t('steps.dynamicDesc')" :code="codes.dynamic">
            <ux-steps mode="number" :current="dynamicCurrent">
                <ux-step v-for="(item, index) in dynamicSteps" :key="index" :name="item" />
            </ux-steps>
            <text class="steps-count">{{ t('steps.dynamicHint') }}: {{ dynamicCount }}</text>
            <view class="demo-btn-row">
                <ux-button custom-class="demo-btn-item" size="small" shape="round" type="primary" @click="addStep()" :disabled="!canAddStep">{{ t('steps.addStep') }}</ux-button>
                <ux-button size="small" shape="round" @click="removeStep()" :disabled="!canRemoveStep">{{ t('steps.removeStep') }}</ux-button>
            </view>
        </demo-block>

    </demo-page>
</template>

<script setup lang="uts">
import { useLocale } from '@/uni_modules/uview-pro-x';
import { codes } from './code';

const { t } = useLocale('demo');

const current1 = ref<number>(1);
const current2 = ref<number>(2);
const current3 = ref<number>(1);
const current4 = ref<number>(1);
const current5 = ref<number>(0);

function prevStep(): void {
    if (current5.value > 0) {
        current5.value--;
    }
}

function nextStep(): void {
    if (current5.value < 2) {
        current5.value++;
    }
}

// —— 动态增删：子项由 v-for 渲染，验证 childrenList 长度与下标联动 ——
const dynamicSteps = ref<string[]>(['步骤一', '步骤二', '步骤三']);
const stepNames: string[] = ['步骤一', '步骤二', '步骤三', '步骤四', '步骤五'];
const dynamicCount = computed<number>((): number => dynamicSteps.value.length);
// current 固定在第二步（不超过末步）：前两步为完成态，后续步骤渲染数字序号，便于观察增删后的下标重排
const dynamicCurrent = computed<number>((): number => dynamicCount.value > 1 ? 1 : 0);
const canAddStep = computed<boolean>((): boolean => dynamicSteps.value.length < 5);
const canRemoveStep = computed<boolean>((): boolean => dynamicSteps.value.length > 1);

function addStep(): void {
    if (dynamicSteps.value.length >= 5) return;
    const next = dynamicSteps.value.slice();
    next.push(stepNames[next.length]);
    dynamicSteps.value = next;
}

function removeStep(): void {
    if (dynamicSteps.value.length <= 1) return;
    const next = dynamicSteps.value.slice();
    next.pop();
    dynamicSteps.value = next;
}
</script>

<style lang="scss">

.demo-btn-row {
    display: flex;
    flex-direction: row;
    margin-top: 15px;
}

.demo-btn-item {
    margin-right: 10px;
}

.steps-count {
    font-size: 12px;
    color: #909399;
    margin-top: 8px;
}
</style>
