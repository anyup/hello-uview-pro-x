<template>
    <demo-page :title="t('subsection.title')" :subtitle="t('subsection.subtitle')">

        <demo-block :title="t('subsection.buttonTitle')" :desc="t('subsection.buttonDesc')" :code="codes.button">
            <ux-subsection :list="list1" :current="current1" @change="onChange1"></ux-subsection>
        </demo-block>

        <demo-block :title="t('subsection.subsectionTitle')" :desc="t('subsection.subsectionDesc')" :code="codes.subsection">
            <ux-subsection :list="list1" :current="current2" mode="subsection" @change="onChange2"></ux-subsection>
        </demo-block>

        <demo-block :title="t('subsection.colorTitle')" :desc="t('subsection.colorDesc')" :code="codes.color">
            <ux-subsection :list="list2" :current="current3" active-color="#fa3534" inactive-color="#909399"></ux-subsection>
        </demo-block>

        <demo-block :title="t('subsection.noAnimTitle')" :desc="t('subsection.noAnimDesc')" :code="codes.noAnim">
            <ux-subsection :list="list1" :current="current4" :animation="false" @change="onChange4"></ux-subsection>
        </demo-block>

        <demo-block :title="t('subsection.customTitle')" :desc="t('subsection.customDesc')" :code="codes.custom">
            <ux-subsection :list="list3" :current="current5" :font-size="12" :height="30" bg-color="#ecf5ff" button-color="#2979ff" active-color="#ffffff" inactive-color="#2979ff"></ux-subsection>
        </demo-block>

        <demo-block :title="t('subsection.disabledTitle')" :desc="t('subsection.disabledDesc')" :code="codes.disabled">
            <ux-subsection :list="list1" :current="current1" disabled></ux-subsection>
            <view class="subsection-gap"></view>
            <ux-subsection :list="list4" :current="current6" active-color="#fa3534" inactive-color="#909399"></ux-subsection>
        </demo-block>

    </demo-page>
</template>

<script setup lang="uts">
import { useLocale, type SubsectionListItem } from '@/uni_modules/uview-pro-x';
import { codes } from './code';

const { t } = useLocale('demo');

const list1: SubsectionListItem[] = [
    { name: 'Tab1' },
    { name: 'Tab2' },
    { name: 'Tab3' }
];

const list2: SubsectionListItem[] = [
    { name: 'A' },
    { name: 'B' },
    { name: 'C' },
    { name: 'D' }
];

const list3: SubsectionListItem[] = [
    { name: 'Day' },
    { name: 'Week' },
    { name: 'Month' }
];

const list4: SubsectionListItem[] = [
    { name: 'A' },
    { name: 'B', disabled: true },
    { name: 'C' }
];

const current1 = ref<number>(0);
const current2 = ref<number>(0);
const current3 = ref<number>(1);
const current4 = ref<number>(0);
const current5 = ref<number>(0);
const current6 = ref<number>(0);

function onChange1(index: number): void {
    current1.value = index;
}

function onChange2(index: number): void {
    current2.value = index;
}

function onChange4(index: number): void {
    current4.value = index;
}
</script>

<style lang="scss">
.subsection-gap {
    height: 10px;
}
</style>