/** 自定义图标样式 icon-style */
const iconStyle = `
<template>
    <view class="page-content">
        <view v-for="(item, index) in items" :key="index" class="scroll-item">
            <text>滚动内容 {{ index + 1 }}</text>
        </view>
        <ux-back-top
            :scroll-top="scrollTop"
            :top="200"
            :bottom="150"
            :right="150"
            :icon-style="{ color: '#2979ff', fontSize: '21px' }"
        />
    </view>
</template>

<script setup lang="uts">
const scrollTop = ref(0);
const items = ref<string[]>([]);
for (let i = 0; i < 20; i++) {
    items.value.push('item_' + i);
}

