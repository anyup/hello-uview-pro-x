/** 自定义位置 bottom / right */
const position = `
<template>
    <view class="page-content">
        <view v-for="(item, index) in items" :key="index" class="scroll-item">
            <text>滚动内容 {{ index + 1 }}</text>
        </view>
        <ux-back-top :scroll-top="scrollTop" :top="200" :bottom="150" :right="100" />
    </view>
</template>

<script setup lang="uts">
const scrollTop = ref(0);
const items = ref<string[]>([]);
for (let i = 0; i < 20; i++) {
    items.value.push('item_' + i);
}

