<template>
    <demo-page :title="t('pagination.title')" :subtitle="t('pagination.subtitle')">

        <demo-block :title="t('pagination.basicTitle')" :desc="t('pagination.basicDesc')" :code="codes.basic">
            <ux-pagination v-model="current1" :total="total" :page-size="pageSize"></ux-pagination>
        </demo-block>

        <demo-block :title="t('pagination.iconTitle')" :desc="t('pagination.iconDesc')" :code="codes.icon">
            <ux-pagination v-model="current2" :total="total" :page-size="pageSize" show-icon></ux-pagination>
        </demo-block>

        <demo-block :title="t('pagination.textTitle')" :desc="t('pagination.textDesc')" :code="codes.text">
            <ux-pagination v-model="current3" :total="total" :page-size="pageSize" prev-text="Prev" next-text="Next"></ux-pagination>
        </demo-block>

        <demo-block :title="t('pagination.customTitle')" :desc="t('pagination.customDesc')" :code="codes.custom">
            <ux-pagination v-model="current4" :total="total" :page-size="pageSize" show-icon :custom-style="customStyle"></ux-pagination>
        </demo-block>

        <demo-block :title="t('pagination.eventTitle')" :desc="t('pagination.eventDesc')" :code="codes.event">
            <ux-pagination v-model="current5" :total="total" :page-size="pageSize" show-icon @change="onChange"></ux-pagination>
            <text class="demo-result">{{ t('pagination.eventResult') }}: {{ current5 }} / {{ totalPages }}</text>
        </demo-block>

    </demo-page>
</template>

<script setup lang="uts">
import { useLocale, createStyle } from '@/uni_modules/uview-pro-x';
import { codes } from './code';

const { t } = useLocale('demo');

const total = 50;
const pageSize = 5;

const current1 = ref<number>(1);
const current2 = ref<number>(1);
const current3 = ref<number>(1);
const current4 = ref<number>(1);
const current5 = ref<number>(1);

const totalPages = Math.ceil(total / pageSize);

const customStyle = computed<UTSJSONObject>(() => {
    const style = createStyle();
    style['backgroundColor'] = '#f5f5f5';
    style['paddingTop'] = '10px';
    style['paddingBottom'] = '10px';
    style['paddingLeft'] = '10px';
    style['paddingRight'] = '10px';
    style['borderRadius'] = '6px';
    return style;
});

function onChange(payload: UTSJSONObject): void {
    const current = payload['current'] as number;
    const type = payload['type'] as string;
    uni.showToast({
        title: type + ' → ' + current,
        icon: 'none'
    });
}
</script>

<style lang="scss">

.demo-result {
    margin-top: 10px;
    font-size: 13px;
    color: $u-tips-color;
}
</style>
