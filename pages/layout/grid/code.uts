/**
 * grid 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 基础用法 */
const basic = `
<template>
    <ux-grid :col="3" @click="onClick">
        <ux-grid-item :index="0">
            <ux-icon name="photo" :size="23" />
            <text class="text">图片</text>
        </ux-grid-item>
        <ux-grid-item :index="1">
            <ux-icon name="lock" :size="23" />
            <text class="text">锁定</text>
        </ux-grid-item>
        <ux-grid-item :index="2">
            <ux-icon name="hourglass" :size="23" />
            <text class="text">沙漏</text>
        </ux-grid-item>
        <ux-grid-item :index="3">
            <ux-icon name="home" :size="23" />
            <text class="text">首页</text>
        </ux-grid-item>
        <ux-grid-item :index="4">
            <ux-icon name="star" :size="23" />
            <text class="text">收藏</text>
        </ux-grid-item>
        <ux-grid-item :index="5">
            <ux-icon name="volume-up" :size="23" />
            <text class="text">音量</text>
        </ux-grid-item>
    </ux-grid>
</template>

<script setup lang="uts">
function onClick(index: string | number): void {
    uni.showToast({ title: '点击了第' + (Number(index) + 1) + '个', icon: 'none' });
}
</script>

<style scoped>
.text {
    font-size: 14px;
    margin-top: 2px;
    color: #909399;
}
</style>
`;

