/**
 * useLocale 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script / style）
 */

/** 当前语言 */
const current = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="当前语言" :value="currentLangText" :arrow="false" />
        <ux-cell-item title="Locale" :value="currentLocaleText" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useLocale } from '@/uni_modules/uview-pro-x';

const { currentLocale } = useLocale();

// currentLocale 可能为 null，统一在计算属性里收敛
const currentLangText = computed((): string => {
    const cur = currentLocale.value;
    if (cur == null) return '-';
    return cur.label + ' (' + cur.name + ')';
});

const currentLocaleText = computed((): string => {
    const cur = currentLocale.value;
    return cur == null ? '-' : cur.locale;
});
</script>
`;

/** 切换语言 */
const switchBlock = `
<template>
    <ux-button size="small" :type="isActive('zh-CN') ? 'primary' : 'info'" block text="简体中文" @click="switchLocale('zh-CN')" />
    <ux-gap :height="8" />
    <ux-button size="small" :type="isActive('en-US') ? 'primary' : 'info'" block text="English" @click="switchLocale('en-US')" />
    <ux-gap :height="8" />
    <ux-button size="small" :type="isActive('fr-FR') ? 'primary' : 'info'" block text="Français" @click="switchLocale('fr-FR')" />
</template>

<script setup lang="uts">
import { useLocale } from '@/uni_modules/uview-pro-x';

const { currentLocale, setLocale } = useLocale();

const currentName = computed((): string => {
    const cur = currentLocale.value;
    return cur == null ? '' : cur.name;
});

function isActive(name: string): boolean {
    return currentName.value == name;
}

// 切换语言，内部会持久化到本地存储
function switchLocale(name: string): void {
    setLocale(name);
}
</script>
`;

/** 组件文案翻译 */
const translate = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item
            v-for="(item, index) in translateRows"
            :key="index"
            :title="item.title"
            :value="item.value"
            :arrow="false"
            :border-bottom="!item.last"
        />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useLocale } from '@/uni_modules/uview-pro-x';

const { t } = useLocale();

type CellRow = {
    title: string;
    value: string;
    last: boolean;
};

// 语言切换后这些文案会随当前语言变化
const translateRows = computed((): CellRow[] => [
    { title: '弹窗标题', value: t('uModal.title'), last: false },
    { title: '确认按钮', value: t('uModal.confirmText'), last: false },
    { title: '搜索占位符', value: t('uSearch.placeholder'), last: false },
    { title: '上传文案', value: t('uUpload.uploadText'), last: true }
]);
</script>
`;

/** 占位符替换 */
const placeholder = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="原文（含占位符）" value="uUpload.notAllowedExt" :arrow="false" />
        <ux-cell-item title="替换后" :value="placeholderReplaced" :arrow="false" :border-bottom="false" />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useLocale } from '@/uni_modules/uview-pro-x';

const { t } = useLocale();

// 第二个参数为替换对象，字符串中的 {ext} 会被替换
const placeholderReplaced = computed((): string => t('uUpload.notAllowedExt', { ext: 'pdf' }));
</script>
`;

/** 命名空间 */
const namespace = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item
            v-for="(item, index) in namespaceRows"
            :key="index"
            :title="item.title"
            :value="item.value"
            :arrow="false"
            :border-bottom="!item.last"
        />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useLocale } from '@/uni_modules/uview-pro-x';

// 指定命名空间后，t 的 key 不必再带前缀
const { t: uploadT } = useLocale('uUpload');

type CellRow = {
    title: string;
    value: string;
    last: boolean;
};

const namespaceRows = computed((): CellRow[] => [
    { title: 'uploadText', value: uploadT('uploadText'), last: false },
    { title: 'uploadImage', value: uploadT('uploadImage'), last: false },
    { title: 'retry', value: uploadT('retry'), last: true }
]);
</script>
`;

/** 语言包列表 */
const locales = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item
            v-for="(item, index) in localeRows"
            :key="index"
            :title="item.title"
            :value="item.value"
            :arrow="false"
            :border-bottom="!item.last"
        />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useLocale } from '@/uni_modules/uview-pro-x';

const { currentLocale, locales } = useLocale();

type CellRow = {
    title: string;
    value: string;
    last: boolean;
};

// last 在数据层生成，模板不需要读源数组长度
const localeRows = computed((): CellRow[] => {
    const list = locales.value;
    const rows: CellRow[] = [];
    for (let i = 0; i < list.length; i++) {
        rows.push({
            title: (i + 1).toString(),
            value: list[i].label + ' (' + list[i].name + ')',
            last: i == list.length - 1
        });
    }
    return rows;
});
</script>
`;

/** 指定语言翻译 */
const merge = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item
            v-for="(item, index) in mergeRows"
            :key="index"
            :title="item.title"
            :value="item.value"
            :arrow="false"
            :border-bottom="!item.last"
        />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useLocale } from '@/uni_modules/uview-pro-x';

const { t } = useLocale();

type CellRow = {
    title: string;
    value: string;
    last: boolean;
};

// 第三个参数指定语言，结果不受当前语言影响
const mergeRows: CellRow[] = [
    { title: 'en-US 分区副标题', value: t('uSection.subTitle', null, 'en-US'), last: false },
    { title: 'en-US 空状态', value: t('uEmpty.data', null, 'en-US'), last: false },
    { title: 'en-US 弹窗标题', value: t('uModal.title', null, 'en-US'), last: false },
    { title: 'fr-FR 空搜索', value: t('uEmpty.search', null, 'fr-FR'), last: false },
    { title: 'fr-FR 分区副标题', value: t('uSection.subTitle', null, 'fr-FR'), last: true }
];
</script>
`;

/** 内置语言包 */
const builtin = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item
            v-for="(item, index) in builtinRows"
            :key="index"
            :title="item.title"
            :value="item.value"
            :arrow="false"
            :border-bottom="!item.last"
        />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useLocale } from '@/uni_modules/uview-pro-x';

const { t } = useLocale();

type CellRow = {
    title: string;
    value: string;
    last: boolean;
};

// 内置语言包覆盖日历、空状态、上传等组件文案
const builtinRows: CellRow[] = [
    {
        title: '星期缩写',
        value: t('uCalendar.sun') + ' ' + t('uCalendar.mon') + ' ' + t('uCalendar.tue') + ' ' + t('uCalendar.wed'),
        last: false
    },
    { title: '年月单位', value: t('uCalendar.year') + ' ' + t('uCalendar.month'), last: false },
    { title: '购物车空', value: t('uEmpty.car'), last: false },
    { title: '搜索空', value: t('uEmpty.search'), last: true }
];
</script>
`;

export const codes = {
    current,
    switchBlock,
    translate,
    placeholder,
    namespace,
    locales,
    merge,
    builtin
};