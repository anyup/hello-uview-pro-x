<template>
    <demo-page :title="t('useDebounce.title')" :subtitle="t('useDebounce.subtitle')">
        <!-- 默认延迟 -->
        <demo-block :title="t('useDebounce.defaultTitle')" :code="codes.defaultDelay">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in defaultRows"
                    :key="index"
                    :title="item.title"
                    :value="item.value"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
            <ux-gap :height="12" />
            <ux-button size="small" type="primary" block :text="t('useDebounce.defaultBtn')" @click="handleDebounceClick()" />
        </demo-block>

        <!-- 自定义延迟 -->
        <demo-block :title="t('useDebounce.customTitle')" :code="codes.custom">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in customRows"
                    :key="index"
                    :title="item.title"
                    :value="item.value"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
            <ux-gap :height="12" />
            <ux-button size="small" type="primary" block :text="t('useDebounce.customBtn')" @click="handleCustomDebounce()" />
        </demo-block>

        <!-- 临时指定延迟 -->
        <demo-block :title="t('useDebounce.dynamicTitle')" :code="codes.dynamic">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in dynamicRows"
                    :key="index"
                    :title="item.title"
                    :value="item.value"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
            <ux-gap :height="12" />
            <ux-button size="small" type="primary" block :text="t('useDebounce.dynamicBtn')" @click="handleDynamicDebounce()" />
        </demo-block>

        <!-- 方法说明 -->
        <demo-block :title="t('useDebounce.usageTitle')" :code="codes.usage">
            <ux-alert-tips type="primary" :show-icon="true" title="const { debounce } = useDebounce(delay)" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useDebounce.usageDelay')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useDebounce.usageDebounce')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useDebounce.usageCallback')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useDebounce.usageTime')" />
        </demo-block>
    </demo-page>
</template>

<script setup lang="uts">
    import { useDebounce, useLocale } from '@/uni_modules/uview-pro-x';
    import { codes } from './code';

    const { t } = useLocale('demo');

    // 解构方式使用：const { debounce } = useDebounce(delay)
    const { debounce } = useDebounce(500);

    type CellRow = {
        title: string;
        value: string;
        last: boolean;
    };

    const clickCount = ref(0);
    const executeCount = ref(0);
    const lastExecuteTime = ref('');

    const customClickCount = ref(0);
    const customExecuteCount = ref(0);

    const dynamicClickCount = ref(0);
    const dynamicExecuteCount = ref(0);

    const defaultRows = computed((): CellRow[] => [
        { title: t('useDebounce.clickCount'), value: clickCount.value.toString(), last: false },
        { title: t('useDebounce.actualExec'), value: executeCount.value.toString(), last: false },
        { title: t('useDebounce.lastExec'), value: lastExecuteTime.value.length > 0 ? lastExecuteTime.value : '-', last: true }
    ]);

    const customRows = computed((): CellRow[] => [
        { title: t('useDebounce.clickCount'), value: customClickCount.value.toString(), last: false },
        { title: t('useDebounce.actualExec'), value: customExecuteCount.value.toString(), last: true }
    ]);

    const dynamicRows = computed((): CellRow[] => [
        { title: t('useDebounce.clickCount'), value: dynamicClickCount.value.toString(), last: false },
        { title: t('useDebounce.actualExec'), value: dynamicExecuteCount.value.toString(), last: true }
    ]);

    // 第二个参数传 null 表示使用 Hook 初始化时的默认延迟
    function handleDebounceClick(): void {
        clickCount.value++;
        debounce((): void => {
            executeCount.value++;
            lastExecuteTime.value = new Date().toLocaleTimeString();
        }, null);
    }

    // 本次调用临时指定 1000ms
    function handleCustomDebounce(): void {
        customClickCount.value++;
        debounce((): void => {
            customExecuteCount.value++;
        }, 1000);
    }

    // 本次调用临时指定 2000ms
    function handleDynamicDebounce(): void {
        dynamicClickCount.value++;
        debounce((): void => {
            dynamicExecuteCount.value++;
        }, 2000);
    }
</script>

<style lang="scss">
    /* 样式由 demo-page 组件提供 */
</style>
