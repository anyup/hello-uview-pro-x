<template>
    <demo-page :title="t('useThrottle.title')" :subtitle="t('useThrottle.subtitle')">
        <!-- 默认间隔 -->
        <demo-block :title="t('useThrottle.defaultTitle')" :code="codes.defaultDelay">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in defaultRows"
                    :key="index"
                    :title="item.title"
                    :value="item.value"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
            <ux-gap :height="12" />
            <ux-button size="small" type="primary" block :text="t('useThrottle.defaultBtn')" @click="handleThrottleClick()" />
        </demo-block>

        <!-- 自定义间隔 -->
        <demo-block :title="t('useThrottle.customTitle')" :code="codes.custom">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in customRows"
                    :key="index"
                    :title="item.title"
                    :value="item.value"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
            <ux-gap :height="12" />
            <ux-button size="small" type="primary" block :text="t('useThrottle.customBtn')" @click="handleCustomThrottle()" />
        </demo-block>

        <!-- 临时指定间隔 -->
        <demo-block :title="t('useThrottle.dynamicTitle')" :code="codes.dynamic">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in dynamicRows"
                    :key="index"
                    :title="item.title"
                    :value="item.value"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
            <ux-gap :height="12" />
            <ux-button size="small" type="primary" block :text="t('useThrottle.dynamicBtn')" @click="handleDynamicThrottle()" />
        </demo-block>

        <!-- 方法说明 -->
        <demo-block :title="t('useThrottle.usageTitle')" :code="codes.usage">
            <ux-alert-tips type="primary" :show-icon="true" title="const { throttle } = useThrottle(delay)" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useThrottle.usageDelay')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useThrottle.usageThrottle')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useThrottle.usageCallback')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useThrottle.usageTime')" />
        </demo-block>
    </demo-page>
</template>

<script setup lang="uts">
    import { useThrottle, useLocale } from '@/uni_modules/uview-pro-x';
    import { codes } from './code';

    const { t } = useLocale('demo');

    // 解构方式使用：const { throttle } = useThrottle(delay)
    const { throttle } = useThrottle(1000);

    type CellRow = {
        title: string;
        value: string;
        last: boolean;
    };

    const clickCount = ref(0);
    const executeCount = ref(0);
    const lastExecuteTime = ref('');

    const customClickCount = ref(0);
    const customExecuteCount = ref(0);

    const dynamicClickCount = ref(0);
    const dynamicExecuteCount = ref(0);

    const defaultRows = computed((): CellRow[] => [
        { title: t('useThrottle.clickCount'), value: clickCount.value.toString(), last: false },
        { title: t('useThrottle.actualExec'), value: executeCount.value.toString(), last: false },
        { title: t('useThrottle.lastExec'), value: lastExecuteTime.value.length > 0 ? lastExecuteTime.value : '-', last: true }
    ]);

    const customRows = computed((): CellRow[] => [
        { title: t('useThrottle.clickCount'), value: customClickCount.value.toString(), last: false },
        { title: t('useThrottle.actualExec'), value: customExecuteCount.value.toString(), last: true }
    ]);

    const dynamicRows = computed((): CellRow[] => [
        { title: t('useThrottle.clickCount'), value: dynamicClickCount.value.toString(), last: false },
        { title: t('useThrottle.actualExec'), value: dynamicExecuteCount.value.toString(), last: true }
    ]);

    // 第二个参数传 null 表示使用 Hook 初始化时的默认间隔
    function handleThrottleClick(): void {
        clickCount.value++;
        throttle((): void => {
            executeCount.value++;
            lastExecuteTime.value = new Date().toLocaleTimeString();
        }, null);
    }

    // 本次调用临时指定 2000ms
    function handleCustomThrottle(): void {
        customClickCount.value++;
        throttle((): void => {
            customExecuteCount.value++;
        }, 2000);
    }

    // 本次调用临时指定 3000ms
    function handleDynamicThrottle(): void {
        dynamicClickCount.value++;
        throttle((): void => {
            dynamicExecuteCount.value++;
        }, 3000);
    }
</script>

<style lang="scss">
    /* 样式由 demo-page 组件提供 */
</style>
