/**
 * useTheme 演示代码片段
 * 每个片段为可直接运行的完整示例（含 template / script）
 */

/** 主题设置面板 */
const panel = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item title="深色模式" :arrow="false">
            <ux-switch :model-value="isInDarkMode()" :active-color="$u.color.primary" @change="onDarkSwitch" />
        </ux-cell-item>
        <ux-cell-item title="跟随系统" :arrow="false">
            <ux-switch :model-value="darkMode == 'auto'" :active-color="$u.color.primary" @change="onAutoSwitch" />
        </ux-cell-item>
        <ux-cell-item title="主题颜色" :value="currentLabel" @click="pickerVisible = true" />
        <ux-cell-item title="多语言" :value="localeLabel" :border-bottom="false" @click="openLocale()" />
    </ux-cell-group>

    <!-- 底部选择器：选中项主色描边 + 浅色底 + 勾选图标 -->
    <ux-popup v-model:show="pickerVisible" mode="bottom" :border-radius="16" :closeable="true">
        <view class="sheet">
            <text class="sheet-title">选择主题</text>
            <view
                v-for="(item, index) in themes"
                :key="item.name"
                class="theme-row"
                :class="item.name == currentName ? 'theme-row--active' : ''"
                @click="pick(item.name)"
            >
                <view class="theme-dot" :style="{ backgroundColor: item.color.primary }"></view>
                <text class="theme-name">{{ item.label }}</text>
                <ux-icon v-if="item.name == currentName" name="checkmark-circle-fill" color="primary" size="20" />
            </view>
        </view>
    </ux-popup>
</template>

<script setup lang="uts">
import { $u, useLocale, useTheme } from '@/uni_modules/uview-pro-x';

const { themes, currentTheme, darkMode, setTheme, setDarkMode, isInDarkMode } = useTheme();
const { currentLocale, setLocale } = useLocale();

const pickerVisible = ref<boolean>(false);

const currentName = computed((): string => {
    const theme = currentTheme.value;
    return theme == null ? '' : theme.name;
});

const currentLabel = computed((): string => {
    const theme = currentTheme.value;
    if (theme == null) return '-';
    return $u.strOr(theme.label, theme.name);
});

const localeLabel = computed((): string => {
    const cur = currentLocale.value;
    return cur == null ? '-' : cur.label;
});

// 开关显示实际生效值：auto 模式下点开关会转成强制亮 / 强制暗
function onDarkSwitch(value: boolean | number | string): void {
    setDarkMode(value === true ? 'dark' : 'light');
}

function onAutoSwitch(value: boolean | number | string): void {
    if (value === true) {
        setDarkMode('auto');
    } else {
        setDarkMode(isInDarkMode() ? 'dark' : 'light');
    }
}

function pick(name: string): void {
    setTheme(name);
    pickerVisible.value = false;
}

function openLocale(): void {
    setLocale('en-US');
}
</script>
`;

/** 暗黑模式三态 */
const dark = `
<template>
    <ux-subsection :list="options" :current="current" @change="onChange" />
    <ux-gap :height="12" />
    <ux-button size="small" type="warning" block text="切换明暗" @click="toggleDarkMode()" />
</template>

<script setup lang="uts">
import { useTheme, type SubsectionListItem } from '@/uni_modules/uview-pro-x';

const { darkMode, setDarkMode, toggleDarkMode } = useTheme();

// 下标与 DarkMode 一一对应：0 auto / 1 light / 2 dark
const options: SubsectionListItem[] = [
    { name: '跟随系统' },
    { name: '亮色' },
    { name: '暗黑' }
];

const current = computed((): number => {
    if (darkMode.value == 'auto') return 0;
    if (darkMode.value == 'light') return 1;
    return 2;
});

function onChange(index: number): void {
    if (index == 0) {
        setDarkMode('auto');
    } else if (index == 1) {
        setDarkMode('light');
    } else {
        setDarkMode('dark');
    }
}
</script>
`;

/** 主题列表 */
const themes = `
<template>
    <view class="theme-list">
        <view
            v-for="(item, index) in rows"
            :key="item.name"
            class="theme-row"
            :class="item.active ? 'theme-row--active' : ''"
            @click="setTheme(item.name)"
        >
            <view class="theme-dot" :style="{ backgroundColor: item.primary }"></view>
            <view class="theme-meta">
                <text class="theme-name">{{ item.label }}</text>
                <text class="theme-code">{{ item.name }}</text>
            </view>
            <text class="theme-primary">{{ item.primary }}</text>
            <ux-icon v-if="item.active" name="checkmark-circle-fill" color="primary" size="20" />
        </view>
    </view>
</template>

<script setup lang="uts">
import { $u, useTheme } from '@/uni_modules/uview-pro-x';

const { themes, currentTheme, setTheme } = useTheme();

type ThemeRow = {
    name: string;
    label: string;
    primary: string;
    active: boolean;
};

// 主题列表来自全局注册（main.uts 的 theme），不在页面内重复注入
const rows = computed((): ThemeRow[] => {
    const list = themes.value;
    const current = currentTheme.value;
    const currentName = current != null ? current.name : '';
    const result: ThemeRow[] = [];
    for (let i = 0; i < list.length; i++) {
        const item = list[i];
        result.push({
            name: item.name,
            label: $u.strOr(item.label, item.name),
            primary: $u.strOr(item.color.primary, '#cccccc'),
            active: item.name == currentName
        });
    }
    return result;
});
</script>
`;

/** 亮 / 暗调色板 */
const palette = `
<template>
    <view class="palette">
        <view class="palette-row" v-for="(row, index) in rows" :key="row.name">
            <text class="palette-name">{{ row.name }}</text>
            <view class="palette-cell">
                <view class="palette-swatch" :style="{ backgroundColor: row.light }"></view>
                <text class="palette-hex">{{ row.lightHex }}</text>
            </view>
            <view class="palette-cell">
                <view class="palette-swatch" :style="{ backgroundColor: row.dark }"></view>
                <text class="palette-hex">{{ row.darkHex }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import { useTheme } from '@/uni_modules/uview-pro-x';

const { currentTheme } = useTheme();

type PaletteRow = {
    name: string;
    light: string;
    dark: string;
    lightHex: string;
    darkHex: string;
};

const TOKENS: string[] = ['primary', 'success', 'warning', 'error', 'info'];

function readToken(json: UTSJSONObject, key: string): string {
    const value = json[key];
    if (value != null && typeof value == 'string') return value as string;
    return '-';
}

// 亮色取 color，暗色取归一化后的 darkColor；缺失的令牌由基础调色板兜底
const rows = computed((): PaletteRow[] => {
    const theme = currentTheme.value;
    if (theme == null) return [];
    const lightJson = JSON.parse(JSON.stringify(theme.color)) as UTSJSONObject;
    const darkColor = theme.darkColor;
    const darkJson = darkColor == null
        ? new UTSJSONObject()
        : (JSON.parse(JSON.stringify(darkColor)) as UTSJSONObject);
    const result: PaletteRow[] = [];
    for (let i = 0; i < TOKENS.length; i++) {
        const key = TOKENS[i];
        const lightHex = readToken(lightJson, key);
        const darkHex = readToken(darkJson, key);
        result.push({
            name: key,
            light: lightHex == '-' ? 'transparent' : lightHex,
            dark: darkHex == '-' ? 'transparent' : darkHex,
            lightHex: lightHex,
            darkHex: darkHex
        });
    }
    return result;
});
</script>
`;

/** 状态与持久化 */
const state = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item
            v-for="(item, index) in rows"
            :key="index"
            :title="item.desc"
            :value="item.result"
            :arrow="false"
            :border-bottom="!item.last"
        />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useLocale, useTheme } from '@/uni_modules/uview-pro-x';

const { themes, currentTheme, darkMode, isInDarkMode } = useTheme();
const { t } = useLocale('demo');

type Row = {
    desc: string;
    result: string;
    last: boolean;
};

const THEME_KEY = 'uview-pro-x-theme';
const DARK_KEY = 'uview-pro-x-dark-mode';

// 默认值不落库：这里能直接看出用户有没有手动切换过
function readSaved(key: string): string {
    try {
        const value = uni.getStorageSync(key);
        if (value != null && typeof value == 'string' && (value as string).length > 0) {
            return value as string;
        }
    } catch (e) {
        // 读取失败按未写入处理
    }
    return '未写入';
}

const rows = computed((): Row[] => {
    const theme = currentTheme.value;
    return [
        { desc: '当前主题：', result: theme != null ? theme.name : '-', last: false },
        { desc: '暗黑设置：', result: darkMode.value, last: false },
        { desc: '生效暗黑：', result: isInDarkMode() ? 'dark' : 'light', last: false },
        { desc: '已存主题：', result: readSaved(THEME_KEY), last: false },
        { desc: '已存暗黑：', result: readSaved(DARK_KEY), last: false },
        { desc: '可用主题数：', result: themes.value.length.toString(), last: true }
    ];
});
</script>
`;

/** 主题 CSS 变量 */
const cssVars = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item
            v-for="(item, index) in rows"
            :key="index"
            :title="item.desc"
            :value="item.result"
            :arrow="false"
            :border-bottom="!item.last"
        />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useTheme } from '@/uni_modules/uview-pro-x';

const { cssVars } = useTheme();

type Row = {
    desc: string;
    result: string;
    last: boolean;
};

// 变量表整体替换，computed 会跟随刷新；config.type 内的令牌加 --u-type 前缀
function cssVar(key: string): string {
    const value = cssVars.value[key];
    if (value == null) return '-';
    return value.toString();
}

const rows = computed((): Row[] => [
    { desc: '--u-theme-mode', result: cssVar('--u-theme-mode'), last: false },
    { desc: '--u-type-primary', result: cssVar('--u-type-primary'), last: false },
    { desc: '--u-type-primary-light', result: cssVar('--u-type-primary-light'), last: false },
    { desc: '--u-type-success', result: cssVar('--u-type-success'), last: false },
    { desc: '--u-main-color', result: cssVar('--u-main-color'), last: false },
    { desc: '--u-bg-color', result: cssVar('--u-bg-color'), last: true }
]);
</script>
`;

/** 恢复默认 */
const reset = `
<template>
    <ux-button size="small" type="primary" block text="恢复默认主题" @click="handleReset()" />
</template>

<script setup lang="uts">
import { useTheme, type Theme } from '@/uni_modules/uview-pro-x';

const { themes, initTheme, setDarkMode } = useTheme();

// 进入页面时记录快照，离开页面按原列表恢复（不写存储）
const initialThemes: Theme[] = themes.value.slice();

// 无参 initTheme() 回到内置主题，并复位为亮色
function handleReset(): void {
    initTheme();
    setDarkMode('light');
}

onUnload((): void => {
    initTheme(initialThemes);
});
</script>
`;

/** 使用说明 */
const usage = `
<template>
    <ux-cell-group :border="false">
        <ux-cell-item
            v-for="(item, index) in rows"
            :key="index"
            :title="item.title"
            :label="item.label"
            :arrow="false"
            :border-bottom="!item.last"
        />
    </ux-cell-group>
</template>

<script setup lang="uts">
import { useTheme, type Theme } from '@/uni_modules/uview-pro-x';

const { themes, initTheme } = useTheme();

type UsageRow = {
    title: string;
    label: string;
    last: boolean;
};

// 进入页面时记录快照，离开时只恢复列表，不改暗黑设置
const initialThemes: Theme[] = themes.value.slice();

onUnload((): void => {
    initTheme(initialThemes);
});

const rows = computed((): UsageRow[] => [
    { title: '同一份主题对象', label: '色板与 CSS 变量都取自 currentTheme，切换后立即生效', last: false },
    { title: '手动切换才落库', label: '默认值不写存储，只有 setTheme / setDarkMode 会持久化', last: false },
    { title: '列表即最终列表', label: 'initTheme([...]) 传入的数组就是最终主题列表，内置主题只作同名项基线', last: false },
    { title: '失效主题名自愈', label: 'storage 里的旧主题名会在初始化时校正为实际生效的主题', last: true }
]);
</script>
`;

export const codes = {
    panel,
    dark,
    themes,
    palette,
    state,
    cssVars,
    reset,
    usage
};
