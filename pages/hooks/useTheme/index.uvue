<template>
    <demo-page :title="t('useTheme.title')" :subtitle="t('useTheme.subtitle')">
        <!-- 当前主题状态 -->
        <demo-block :title="t('useTheme.stateTitle')" :desc="t('useTheme.stateDesc')" :code="codes.state">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in stateRows"
                    :key="index"
                    :title="item.desc"
                    :value="item.result"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
        </demo-block>

        <!-- 主题切换 -->
        <demo-block :title="t('useTheme.themeTitle')" :desc="t('useTheme.themeDesc')" :code="codes.theme">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in themeRows"
                    :key="index"
                    :title="item.label"
                    :label="item.name"
                    :value="item.active ? t('useTheme.themeCurrent') : ''"
                    :arrow="true"
                    :border-bottom="!item.last"
                    @click="handleSetTheme(item.name)"
                >
                    <template #icon>
                        <view class="demo-theme-dot" :style="{ backgroundColor: item.primary }"></view>
                    </template>
                </ux-cell-item>
            </ux-cell-group>
        </demo-block>

        <!-- 暗黑模式 -->
        <demo-block :title="t('useTheme.darkTitle')" :desc="t('useTheme.darkDesc')" :code="codes.dark">
            <ux-row :gutter="10">
                <ux-col :span="4">
                    <ux-button
                        size="small"
                        :type="isLightMode ? 'primary' : 'info'"
                        block
                        :text="t('useTheme.darkLight')"
                        @click="handleSetDarkMode('light')"
                    />
                </ux-col>
                <ux-col :span="4">
                    <ux-button
                        size="small"
                        :type="isDarkMode ? 'primary' : 'info'"
                        block
                        :text="t('useTheme.darkDark')"
                        @click="handleSetDarkMode('dark')"
                    />
                </ux-col>
                <ux-col :span="4">
                    <ux-button
                        size="small"
                        :type="isAutoMode ? 'primary' : 'info'"
                        block
                        :text="t('useTheme.darkAuto')"
                        @click="handleSetDarkMode('auto')"
                    />
                </ux-col>
            </ux-row>
            <ux-gap :height="10" />
            <ux-button size="small" type="warning" block :text="t('useTheme.darkToggle')" @click="handleToggleDark()" />
        </demo-block>

        <!-- 主题 CSS 变量 -->
        <demo-block :title="t('useTheme.cssVarsTitle')" :desc="t('useTheme.cssVarsDesc')" :code="codes.cssVars">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in cssVarRows"
                    :key="index"
                    :title="item.desc"
                    :value="item.result"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
        </demo-block>

        <!-- 恢复默认 -->
        <demo-block :title="t('useTheme.resetTitle')" :desc="t('useTheme.resetDesc')" :code="codes.reset">
            <ux-button size="small" type="primary" block :text="t('useTheme.resetBtn')" @click="handleReset()" />
        </demo-block>

        <!-- 使用说明 -->
        <demo-block :title="t('useTheme.usageTitle')" :code="codes.usage">
            <ux-alert-tips type="primary" :show-icon="true" title="const { themes, currentTheme, setTheme } = useTheme()" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useTheme.usage1')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useTheme.usage2')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useTheme.usage3')" />
        </demo-block>
    </demo-page>
</template>

<script setup lang="uts">
    import { $u, useTheme, useLocale, type DarkMode, type Theme, type ThemeColor } from '@/uni_modules/uview-pro-x';
    import { codes } from './code';

    const { t } = useLocale('demo');

    // 解构方式使用：const { currentTheme, setTheme } = useTheme()
    const { themes, currentTheme, darkMode, cssVars, initTheme, setTheme, setDarkMode, toggleDarkMode, isInDarkMode } = useTheme();

    type Row = {
        desc: string;
        result: string;
        last: boolean;
    };

    type ThemeRow = {
        name: string;
        label: string;
        primary: string;
        active: boolean;
        last: boolean;
    };

    // 演示主题：只覆盖主色，其余令牌由主题引擎回退到基础调色板
    function buildDemoTheme(name: string, label: string, primary: string): Theme {
        const palette: ThemeColor = { primary: primary };
        const theme: Theme = { name: name, label: label, color: palette };
        return theme;
    }

    // 进入页面注入两个演示主题（与内置主题合并，同名覆盖）
    initTheme([buildDemoTheme('demoPurple', t('useTheme.demoPurple'), '#7c4dff'), buildDemoTheme('demoGreen', t('useTheme.demoGreen'), '#00b578')]);

    const stateRows = computed((): Row[] => {
        const theme = currentTheme.value;
        return [
            { desc: t('useTheme.stateTheme'), result: theme != null ? theme.name : '-', last: false },
            { desc: t('useTheme.stateMode'), result: darkMode.value, last: false },
            { desc: t('useTheme.stateResolved'), result: isInDarkMode() ? 'dark' : 'light', last: false },
            { desc: t('useTheme.stateCount'), result: themes.value.length.toString(), last: true }
        ];
    });

    const themeRows = computed((): ThemeRow[] => {
        const list = themes.value;
        const current = currentTheme.value;
        const currentName = current != null ? current.name : '';
        const rows: ThemeRow[] = [];
        for (let i = 0; i < list.length; i++) {
            const item = list[i];
            rows.push({
                name: item.name,
                label: $u.strOr(item.label, item.name),
                primary: $u.strOr(item.color.primary, ''),
                active: item.name == currentName,
                last: i == list.length - 1
            });
        }
        return rows;
    });

    const isLightMode = computed((): boolean => darkMode.value == 'light');
    const isDarkMode = computed((): boolean => darkMode.value == 'dark');
    const isAutoMode = computed((): boolean => darkMode.value == 'auto');

    // 取 CSS 变量值：变量表整体替换，computed 会跟随刷新
    // 主色 / 成功色等 config.type 内的令牌会加 --u-type 前缀
    function cssVar(key: string): string {
        const value = cssVars.value[key];
        if (value == null) return '-';
        return value.toString();
    }

    const cssVarRows = computed((): Row[] => [
        { desc: '--u-theme-mode', result: cssVar('--u-theme-mode'), last: false },
        { desc: '--u-type-primary', result: cssVar('--u-type-primary'), last: false },
        { desc: '--u-type-success', result: cssVar('--u-type-success'), last: false },
        { desc: '--u-main-color', result: cssVar('--u-main-color'), last: true }
    ]);

    function handleSetTheme(name: string): void {
        setTheme(name);
    }

    function handleSetDarkMode(mode: DarkMode): void {
        setDarkMode(mode);
    }

    function handleToggleDark(): void {
        toggleDarkMode();
    }

    // 恢复默认：无参 initTheme() 回到内置主题，并把解析后的主题名写回存储
    function restoreDefault(): void {
        initTheme();
        setDarkMode('light');
        const current = currentTheme.value;
        if (current != null) setTheme(current.name);
    }

    function handleReset(): void {
        restoreDefault();
    }

    // 离开页面恢复，避免演示主题与暗黑设置残留到其他示例页
    onUnload((): void => {
        restoreDefault();
    });
</script>

<style lang="scss">
    /* 主题色圆点需真实渲染色值，属必要例外：仅 background-color 走内联 */
    .demo-theme-dot {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border: 1px solid $u-border-color;
    }
</style>
