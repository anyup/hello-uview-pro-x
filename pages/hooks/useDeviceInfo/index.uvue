<template>
    <demo-page :title="t('useDeviceInfo.title')" :subtitle="t('useDeviceInfo.subtitle')">
        <!-- 设备身份 -->
        <demo-block :title="t('useDeviceInfo.deviceTitle')" :desc="t('useDeviceInfo.deviceDesc')" :code="codes.device">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in deviceRows"
                    :key="index"
                    :title="item.desc"
                    :value="item.result"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
        </demo-block>

        <!-- 系统与平台 -->
        <demo-block :title="t('useDeviceInfo.systemTitle')" :desc="t('useDeviceInfo.systemDesc')" :code="codes.system">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in systemRows"
                    :key="index"
                    :title="item.desc"
                    :value="item.result"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
        </demo-block>

        <!-- 屏幕方向 -->
        <demo-block :title="t('useDeviceInfo.orientationTitle')" :desc="t('useDeviceInfo.orientationDesc')" :code="codes.orientation">
            <ux-cell-group :border="false">
                <ux-cell-item
                    v-for="(item, index) in orientationRows"
                    :key="index"
                    :title="item.desc"
                    :value="item.result"
                    :arrow="false"
                    :border-bottom="!item.last"
                />
            </ux-cell-group>
            <ux-gap :height="12" />
            <ux-alert-tips type="warning" :show-icon="true" :title="t('useDeviceInfo.orientationHint')" />
        </demo-block>

        <!-- 使用说明 -->
        <demo-block :title="t('useDeviceInfo.usageTitle')" :code="codes.usage">
            <ux-alert-tips type="primary" :show-icon="true" title="const { info, deviceBrand, platform } = useDeviceInfo()" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useDeviceInfo.usage1')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useDeviceInfo.usage2')" />
            <ux-gap :height="8" />
            <ux-alert-tips type="primary" :show-icon="true" :title="t('useDeviceInfo.usage3')" />
        </demo-block>
    </demo-page>
</template>

<script setup lang="uts">
    import { $u, useDeviceInfo, useLocale } from '@/uni_modules/uview-pro-x';
    import { codes } from './code';

    const { t } = useLocale('demo');

    // 解构方式使用：const { deviceBrand } = useDeviceInfo()
    const { info } = useDeviceInfo();

    type Row = {
        desc: string;
        result: string;
        last: boolean;
    };

    // 部分平台字段为空串，展示层统一用 $u.strOr 回退
    const deviceRows = computed((): Row[] => {
        const current = info.value;
        return [
            { desc: 'deviceBrand', result: $u.strOr(current.deviceBrand, '-'), last: false },
            { desc: 'deviceModel', result: $u.strOr(current.deviceModel, '-'), last: false },
            { desc: 'deviceType', result: $u.strOr(current.deviceType, '-'), last: true }
        ];
    });

    const systemRows = computed((): Row[] => {
        const current = info.value;
        return [
            { desc: 'platform', result: $u.strOr(current.platform, '-'), last: false },
            { desc: 'osName', result: $u.strOr(current.osName, '-'), last: false },
            { desc: 'osVersion', result: $u.strOr(current.osVersion, '-'), last: false },
            { desc: 'system', result: $u.strOr(current.system, '-'), last: true }
        ];
    });

    const orientationRows = computed((): Row[] => [
        { desc: 'deviceOrientation', result: $u.strOr(info.value.deviceOrientation, '-'), last: true }
    ]);
</script>

<style lang="scss">
    /* 样式由 demo-page 组件提供 */
</style>
