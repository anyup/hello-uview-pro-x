<template>
    <view class="demo-result" :class="'demo-result--' + type">
        <text class="demo-result-text">{{ text }}</text>
    </view>
</template>

<script setup lang="uts">
    defineOptions({
        name: 'demo-result',
        styleIsolation: 'app-and-page'
    });

    /**
     * 演示结果展示组件 - 统一结果状态样式
     * - type：状态类型（default 主色 / success 成功 / error 错误 / warning 警告）
     * - text：结果文本
     */
    const props = withDefaults(defineProps<{
        type?: 'default' | 'success' | 'error' | 'warning';
        text: string;
    }>(), {
        type: 'default'
    });
</script>

